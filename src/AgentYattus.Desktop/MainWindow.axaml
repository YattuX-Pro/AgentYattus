<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:AgentYattus.Client.Core"
        xmlns:views="using:AgentYattus.Desktop.Views"
        x:Class="AgentYattus.Desktop.MainWindow"
        x:DataType="core:ShellViewModel"
        Title="Agent Yattus"
        Width="1280" Height="820" MinWidth="900" MinHeight="640"
        FontFamily="{StaticResource Sans}"
        Foreground="{StaticResource Parchemin}"
        Background="{StaticResource Obsidienne}">

  <!-- Chaque type de ViewModel s'affiche avec sa vue : la coquille ne connaît que « l'écran courant ». -->
  <Window.DataTemplates>
    <DataTemplate DataType="core:LoginViewModel"><views:LoginView /></DataTemplate>
    <DataTemplate DataType="core:HomeViewModel"><views:HomeView /></DataTemplate>
    <DataTemplate DataType="core:OfficeViewModel"><views:OfficeView /></DataTemplate>
    <DataTemplate DataType="core:AgentsViewModel"><views:AgentsView /></DataTemplate>
    <DataTemplate DataType="core:ReportsViewModel"><views:ReportsView /></DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="Auto,*,Auto">
    <Grid.Background>
      <!-- Grille de points de la maquette. -->
      <VisualBrush TileMode="Tile" SourceRect="0,0,24,24" DestinationRect="0,0,24,24">
        <VisualBrush.Visual>
          <Canvas Width="24" Height="24" Background="{StaticResource Obsidienne}">
            <Ellipse Canvas.Left="0" Canvas.Top="0" Width="2" Height="2" Fill="#1C1F23" />
          </Canvas>
        </VisualBrush.Visual>
      </VisualBrush>
    </Grid.Background>

    <!-- En-tête flottant (absent de l'écran de connexion, qui a sa propre marque) -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*" Margin="20,10" MinHeight="40" IsVisible="{Binding IsAuthenticated}">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Viewbox Width="26" Height="26">
          <Canvas Width="26" Height="26">
            <Rectangle Canvas.Left="0.5" Canvas.Top="0.5" Width="25" Height="25" RadiusX="7" RadiusY="7" Stroke="#2B2F34" />
            <Path Data="M13 13.5V19.5M13 13.5L7.5 7.5M13 13.5L18.5 7.5" Stroke="{StaticResource VertDeGris}" StrokeThickness="1.6" StrokeLineCap="Round" />
            <Ellipse Canvas.Left="5.6" Canvas.Top="5.6" Width="3.8" Height="3.8" Fill="{StaticResource Parchemin}" />
            <Ellipse Canvas.Left="16.6" Canvas.Top="5.6" Width="3.8" Height="3.8" Fill="{StaticResource Parchemin}" />
            <Ellipse Canvas.Left="11.1" Canvas.Top="17.6" Width="3.8" Height="3.8" Fill="{StaticResource Laiton}" />
            <Ellipse Canvas.Left="10.8" Canvas.Top="11.3" Width="4.4" Height="4.4" Fill="{StaticResource Obsidienne}" Stroke="{StaticResource VertDeGris}" StrokeThickness="1.6" />
          </Canvas>
        </Viewbox>
        <TextBlock Text="Agent Yattus" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>

      <Border Grid.Column="1" Padding="4" CornerRadius="12" Background="#EB16181B" BorderBrush="{StaticResource Filet}" BorderThickness="1"
              IsVisible="{Binding IsAuthenticated}">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Classes="tab" Classes.active="{Binding IsMissionsSection}" Command="{Binding GoHomeCommand}">
            <ContentControl Foreground="{Binding $parent[Button].Foreground}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Classes="icon" Data="M8.5 18H15a3 3 0 0 0 0-6H9a3 3 0 0 1 0-6h6.5M3.5 18a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0M15.5 6a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0-5 0" />
                <TextBlock Text="Missions" FontSize="13" FontWeight="Medium" />
              </StackPanel>
            </ContentControl>
          </Button>
          <Button Classes="tab" Classes.active="{Binding IsAgentsSection}" Command="{Binding ShowAgentsCommand}">
            <ContentControl Foreground="{Binding $parent[Button].Foreground}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Classes="icon" Data="M12 12.5V17M12 12.5L7 7M12 12.5L17 7M3.5 5.5a2 2 0 1 0 4 0a2 2 0 1 0-4 0M16.5 5.5a2 2 0 1 0 4 0a2 2 0 1 0-4 0M10 19a2 2 0 1 0 4 0a2 2 0 1 0-4 0" />
                <TextBlock Text="Agents" FontSize="13" FontWeight="Medium" />
              </StackPanel>
            </ContentControl>
          </Button>
          <Button Classes="tab" Classes.active="{Binding IsReportsSection}" Command="{Binding ShowReportsCommand}">
            <ContentControl Foreground="{Binding $parent[Button].Foreground}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Classes="icon" Data="M7 3.5h7l5 5v12H7zM14 3.5v5h5M10 13h6M10 16.5h6" />
                <TextBlock Text="Rapports" FontSize="13" FontWeight="Medium" />
              </StackPanel>
            </ContentControl>
          </Button>
        </StackPanel>
      </Border>
      <!-- L'utilisateur connecté, et la déconnexion. -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center"
                  IsVisible="{Binding IsAuthenticated}">
        <Border Height="30" Padding="10,0" CornerRadius="15" Background="#EB16181B" BorderBrush="{StaticResource Filet}" BorderThickness="1">
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" Fill="{StaticResource VertDeGris}" />
            <TextBlock Classes="mono" Text="{Binding UserName}" FontSize="12" />
          </StackPanel>
        </Border>
        <!-- La gestion se fait dans l'espace admin web (ADR 0008) : le bouton l'ouvre dans le navigateur. -->
        <Button Classes="square" Width="36" Height="36" Padding="0" Command="{Binding OpenAdminCommand}" ToolTip.Tip="Ouvrir l’espace admin"
                IsVisible="{Binding IsLlmAdmin}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
          <Path Data="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"
                Stroke="{StaticResource Pierre}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" Width="15" Height="15" Stretch="Uniform" />
        </Button>
        <Button Classes="square" Width="36" Height="36" Padding="0" Command="{Binding LogoutCommand}" ToolTip.Tip="Se déconnecter"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
          <Path Data="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 17l5-5-5-5M15 12H4" Stroke="{StaticResource Pierre}"
                StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" Width="15" Height="15" Stretch="Uniform" />
        </Button>
      </StackPanel>
    </Grid>

    <ContentControl Grid.Row="1" Content="{Binding Current}" />

    <!-- Barre d'état -->
    <Border Grid.Row="2" MinHeight="36" Padding="20,6" IsVisible="{Binding IsAuthenticated}" BorderBrush="#1F2226" BorderThickness="0,1,0,0" Background="#F00E0F11">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="22">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" Fill="{StaticResource VertDeGris}" IsVisible="{Binding Home.IsBackendConnected}" />
          <Ellipse Width="7" Height="7" Fill="{StaticResource Cinabre}" IsVisible="{Binding !Home.IsBackendConnected}" />
          <TextBlock Classes="mono" Text="Backend" FontSize="11.5" Foreground="{StaticResource Pierre}" />
          <TextBlock Classes="mono" Text="localhost:5080" FontSize="11.5" Foreground="{StaticResource Cendre}" />
        </StackPanel>
        <TextBlock Grid.Column="2" Classes="mono" Text="v0.1.0" FontSize="11.5" Foreground="{StaticResource Cendre}" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
