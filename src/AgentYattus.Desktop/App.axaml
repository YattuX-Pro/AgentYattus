<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AgentYattus.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AgentYattus.Desktop/Theme/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <!-- Les accents des majuscules (É, À) dépassent la hauteur de ligne de la police : sans ceci, ils sont coupés. -->
    <Style Selector="TextBlock">
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
  </Application.Styles>
</Application>
