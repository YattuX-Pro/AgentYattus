<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Palette « observatoire » : fonds du plus sombre au plus clair, puis textes, puis accents. -->
  <SolidColorBrush x:Key="Obsidienne" Color="#0B0C0E" />
  <SolidColorBrush x:Key="Nuit" Color="#121316" />
  <SolidColorBrush x:Key="Graphite" Color="#16181B" />
  <SolidColorBrush x:Key="Filet" Color="#24272B" />
  <SolidColorBrush x:Key="Parchemin" Color="#ECE6D8" />
  <SolidColorBrush x:Key="Pierre" Color="#A7A196" />
  <SolidColorBrush x:Key="Cendre" Color="#8A857B" />
  <SolidColorBrush x:Key="VertDeGris" Color="#5E9E92" />
  <SolidColorBrush x:Key="Laiton" Color="#D8B86E" />
  <SolidColorBrush x:Key="Cinabre" Color="#D9654B" />
  <!-- Les polices de la maquette, embarquées (Assets/Fonts, licence OFL). -->
  <FontFamily x:Key="Sans">avares://AgentYattus.Desktop/Assets/Fonts#Instrument Sans</FontFamily>
  <FontFamily x:Key="Mono">avares://AgentYattus.Desktop/Assets/Fonts#IBM Plex Mono</FontFamily>
</ResourceDictionary>
