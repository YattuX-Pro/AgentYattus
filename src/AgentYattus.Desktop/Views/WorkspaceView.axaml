<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:AgentYattus.Client.Core" xmlns:contracts="using:AgentYattus.Contracts"
             xmlns:views="using:AgentYattus.Desktop.Views" x:Class="AgentYattus.Desktop.Views.WorkspaceView"
             x:DataType="core:WorkspaceViewModel" Foreground="{StaticResource Parchemin}">
  <UserControl.Styles>
    <Style Selector="Border.message"><Setter Property="Padding" Value="12,9" /><Setter Property="Margin" Value="0,0,56,8" /><Setter Property="CornerRadius" Value="0,12,12,12" /><Setter Property="Background" Value="#202C33" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="MaxWidth" Value="660" /></Style>
    <Style Selector="Border.message.user"><Setter Property="Background" Value="#005C4B" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="Margin" Value="56,0,0,8" /><Setter Property="CornerRadius" Value="12,0,12,12" /></Style>
    <Style Selector="Button.tab"><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="14,7" /></Style>
    <Style Selector="Button, Button:pointerover, Button:pressed"><Setter Property="RenderTransform" Value="none" /></Style>
    <Style Selector="TextBox.chatInput"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontSize" Value="14" /><Setter Property="Padding" Value="10,8" /></Style>
    <Style Selector="Button.thread"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="12" /></Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="*" RowDefinitions="Auto,*" Background="#0B141A">
    <Border BorderBrush="{StaticResource Filet}" BorderThickness="0,0,0,1" Padding="22,12" Background="#202C33">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="12"><Border Width="40" Height="40" CornerRadius="20" Background="#00A884"><TextBlock Text="Y" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" /></Border><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Text="{Binding ProjectName}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Groupe de l’équipe" FontSize="12" Foreground="#AEBAC1" /></StackPanel></StackPanel>
        <Button Grid.Column="1" Classes="outline" Content="Bureau animé" Command="{Binding OpenOfficeCommand}" />
        <ComboBox Grid.Column="2" Width="200" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}">
          <ComboBox.ItemTemplate><DataTemplate x:DataType="contracts:ProjectDto"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="0" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0">
      <TextBlock Margin="24,6" IsVisible="{Binding !IsConnected}" Text="Connexion interrompue · votre brouillon est conservé" Foreground="{StaticResource Laiton}" FontSize="12" />
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Background="#202C33" Margin="0" Height="42">
        <Button Classes="tab" Classes.active="{Binding IsConversation}" Content="Conversation" Command="{Binding ShowConversationCommand}" />
        <Button Classes="tab" Classes.active="{Binding IsActivity}" Content="Activité" Command="{Binding ShowActivityCommand}" />
        <Button Classes="tab" Classes.active="{Binding IsDeliverables}" Content="Livrables" Command="{Binding ShowDeliverablesCommand}" />
      </StackPanel>
      <Grid Grid.Row="2" Margin="24,16,24,0">
        <ScrollViewer x:Name="MessagesScroll" IsVisible="{Binding IsConversation}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Button Classes="link" Content="Charger les messages précédents" Command="{Binding OlderConversationsCommand}" HorizontalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="core:WorkspaceMessage">
              <Border Classes="message" Classes.user="{Binding FromUser}"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="9"><views:Avatar Image="{Binding Avatar}" Label="{Binding Name}" Size="28" RingWidth="0" IsVisible="{Binding !FromUser}" /><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Address}" FontSize="11.5" FontWeight="SemiBold" Foreground="#6DD4BC" /><SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" LineHeight="20" Foreground="#E9EDEF" /><TextBlock Text="{Binding Time}" FontSize="10" Foreground="#AEBAC1" HorizontalAlignment="Right" /></StackPanel></Grid></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Button Classes="outline" Content="Valider et garder comme livrable" Command="{Binding AcceptResultCommand}" IsVisible="{Binding CanAcceptResult}" HorizontalAlignment="Left" Margin="12,0,0,12" />
            <Button Classes="outline" Content="Voir la demande transmise au RH" Command="{Binding OpenRhCommand}" IsVisible="{Binding RhHandoff, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" HorizontalAlignment="Left" Margin="12,0,0,12" />
            <Border IsVisible="{Binding HasProfile}" Padding="14" Margin="0,8,56,12" Background="#202C33" CornerRadius="12" MaxWidth="660" HorizontalAlignment="Left">
              <StackPanel Spacing="8"><TextBlock Text="{Binding Profile.Name}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding Profile.Summary}" TextWrapping="Wrap" FontSize="13" /><Expander Header="Voir les consignes, outils et compétences"><StackPanel Spacing="8"><SelectableTextBlock Text="{Binding Profile.Instructions}" TextWrapping="Wrap" FontSize="12" /><ItemsControl ItemsSource="{Binding Profile.Skills}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="contracts:RecruitmentSkillDto"><StackPanel Spacing="4" Margin="0,8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Expander><Button Classes="primary" Content="Ajouter à l’équipe" Command="{Binding PrepareRecruitmentCommand}" HorizontalAlignment="Left" /></StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer IsVisible="{Binding IsActivity}"><StackPanel Spacing="12"><TextBlock Text="Tâches du projet" FontWeight="SemiBold" /><ItemsControl ItemsSource="{Binding Activity}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="core:MissionItem"><Button Classes="thread" Command="{Binding $parent[UserControl].((core:WorkspaceViewModel)DataContext).OpenMissionCommand}" CommandParameter="{Binding}"><StackPanel Spacing="4"><TextBlock Text="{Binding Goal}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding StatusLabel}" FontSize="12" Foreground="{StaticResource Pierre}" /></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Classes="outline" Content="Charger les échanges plus anciens" Command="{Binding OlderConversationsCommand}" HorizontalAlignment="Left" /><Expander Header="Détails de la demande sélectionnée"><ItemsControl ItemsSource="{Binding Timeline}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="core:TimelineEntry"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,4" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></StackPanel></ScrollViewer>
        <ScrollViewer IsVisible="{Binding IsDeliverables}"><ItemsControl ItemsSource="{Binding Deliverables}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="core:MissionItem"><Button Classes="thread" Command="{Binding $parent[UserControl].((core:WorkspaceViewModel)DataContext).OpenMissionCommand}" CommandParameter="{Binding}"><StackPanel Spacing="5"><TextBlock Text="{Binding Goal}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding When}" FontSize="12" Foreground="{StaticResource Pierre}" /><TextBlock Text="Retrouver dans le groupe" FontSize="12" Foreground="{StaticResource VertDeGris}" /></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      </Grid>
      <StackPanel Grid.Row="3" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding IsConversation}">
        <Border IsVisible="{Binding HasWorkingAgents}" Margin="24,0" Padding="12,8" Background="#202C33" CornerRadius="12" HorizontalAlignment="Left" AutomationProperties.Name="Activité des agents"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding WorkingLabel}" Foreground="#6DD4BC" FontSize="12" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><Ellipse x:Name="TypingDot1" Width="5" Height="5" Fill="#AEBAC1" /><Ellipse x:Name="TypingDot2" Width="5" Height="5" Fill="#AEBAC1" /><Ellipse x:Name="TypingDot3" Width="5" Height="5" Fill="#AEBAC1" /></StackPanel></StackPanel></Border>
        <ItemsControl ItemsSource="{Binding PendingTasks}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="core:MissionItem"><Button Classes="thread" Command="{Binding $parent[UserControl].((core:WorkspaceViewModel)DataContext).OpenMissionCommand}" CommandParameter="{Binding}"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="{Binding Goal}" MaxHeight="24" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding StatusLabel}" Foreground="{StaticResource Laiton}" FontSize="12" /></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <Button Classes="outline" Content="Nouvelle réponse ↓" IsVisible="{Binding HasNewMessages}" Click="ReadLatest" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="{StaticResource Cinabre}" TextWrapping="Wrap" FontSize="12" />
        <Border IsVisible="{Binding HasApproval}" Background="#252117" Padding="12" CornerRadius="10"><StackPanel Spacing="8"><TextBlock Text="Votre accord est nécessaire" Foreground="{StaticResource Laiton}" FontWeight="SemiBold" /><ItemsControl ItemsSource="{Binding Approvals}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="core:ApprovalItem"><StackPanel Spacing="6"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" /><Expander Header="Voir tous les détails"><ItemsControl ItemsSource="{Binding AllLines}" /></Expander></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><CheckBox Content="J’ai relu tous les détails" IsChecked="{Binding AllApprovalShown}" /><StackPanel Orientation="Horizontal" Spacing="12"><Button Classes="primary" Content="Autoriser" Command="{Binding ApproveCommand}" /><Button Classes="outline" Content="Refuser" Command="{Binding RefuseCommand}" /></StackPanel></StackPanel></Border>
        <Border IsVisible="{Binding RecruitmentSetup, Converter={x:Static ObjectConverters.IsNotNull}}" Background="#1A2220" Padding="14" CornerRadius="10">
          <StackPanel Spacing="10"><TextBlock Text="Choisir le prénom et le visage" FontWeight="SemiBold" /><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><ComboBox ItemsSource="{Binding RecruitmentSetup.Portraits}" SelectedItem="{Binding RecruitmentSetup.Selected}"><ComboBox.ItemTemplate><DataTemplate x:DataType="core:PortraitChoice"><StackPanel Orientation="Horizontal" Spacing="8"><views:Avatar Image="{Binding Image}" Label="{Binding Portrait.SuggestedName}" Size="32" RingWidth="0" /><TextBlock Text="{Binding Portrait.SuggestedName}" VerticalAlignment="Center" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBox Grid.Column="1" Text="{Binding RecruitmentSetup.Name}" PlaceholderText="Prénom" /></Grid><TextBlock Text="{Binding RecruitmentSetup.Error}" Foreground="{StaticResource Cinabre}" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="12"><Button Classes="primary" Content="Confirmer l’ajout" Command="{Binding RecruitmentSetup.RecruitCommand}" /><Button Classes="link" Content="Annuler" Command="{Binding CloseRecruitmentCommand}" /></StackPanel></StackPanel>
        </Border>
        <Border Padding="16,10" Background="#202C33"><StackPanel Spacing="5"><Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
          <ComboBox Width="146" ItemsSource="{Binding Contacts}" SelectedItem="{Binding Addressee}" AutomationProperties.Name="Agent sollicité dans le groupe" VerticalAlignment="Bottom" ToolTip.Tip="Choisir qui répond dans le groupe"><ComboBox.ItemTemplate><DataTemplate x:DataType="core:ConversationContact"><StackPanel Orientation="Horizontal" Spacing="7"><views:Avatar Image="{Binding Avatar}" Label="{Binding Name}" Size="24" RingWidth="0" /><TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
          <Border Grid.Column="1" Background="#2A3942" CornerRadius="22"><TextBox Classes="chatInput" Text="{Binding Input, Mode=TwoWay}" views:ChatInput.Send="{Binding SendCommand}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42" MaxHeight="110" MaxLength="4000" PlaceholderText="Écrivez au groupe…" AutomationProperties.Name="Message au groupe" /></Border>
          <Button Grid.Column="2" Classes="link" Content="Arrêter" Command="{Binding StopCommand}" IsVisible="{Binding CanStop}" VerticalAlignment="Bottom" />
          <Button Grid.Column="3" Background="#00A884" Foreground="#0B141A" CornerRadius="23" Width="44" Height="44" Padding="0" Command="{Binding SendCommand}" AutomationProperties.Name="Envoyer le message" ToolTip.Tip="Envoyer (Entrée)" VerticalAlignment="Bottom"><Path Data="M 2,2 L 22,12 L 2,22 L 6,13 L 15,12 L 6,11 Z" Fill="#0B141A" Width="21" Height="21" Stretch="Uniform" /></Button>
        </Grid><TextBlock Text="Entrée pour envoyer · Maj + Entrée pour une nouvelle ligne" FontSize="10" Foreground="#8696A0" Margin="156,0,0,0" /></StackPanel></Border>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
