<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:AgentYattus.Client.Core"
             xmlns:contracts="using:AgentYattus.Contracts"
             xmlns:views="using:AgentYattus.Desktop.Views"
             x:Class="AgentYattus.Desktop.Views.SettingsView"
             x:DataType="core:SettingsViewModel"
             Foreground="{StaticResource Parchemin}">

  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="22" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Background" Value="{StaticResource Graphite}" />
      <Setter Property="BorderBrush" Value="{StaticResource Filet}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.field, TextBox.field:pointerover, TextBox.field:focus">
      <Setter Property="Foreground" Value="{StaticResource Parchemin}" />
    </Style>
    <Style Selector="TextBox.field /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource Obsidienne}" />
      <Setter Property="BorderBrush" Value="{StaticResource Filet}" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource Obsidienne}" />
      <Setter Property="BorderBrush" Value="{StaticResource VertDeGris}" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.action /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#3A3F45" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Foreground" Value="{StaticResource Parchemin}" />
    </Style>
    <Style Selector="Button.action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Nuit}" />
    </Style>
    <Style Selector="Button.action.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource VertDeGris}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource Obsidienne}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.action.danger /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="#66D9654B" />
      <Setter Property="Foreground" Value="{StaticResource Cinabre}" />
    </Style>
    <Style Selector="Button.action.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#14D9654B" />
    </Style>
    <Style Selector="Button.action:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Filet}" />
      <Setter Property="Foreground" Value="{StaticResource Cendre}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.card.revoked">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <!-- Une ligne cliquable : un modèle du sélecteur, un fournisseur à connecter. -->
    <Style Selector="Button.row">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.row /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Parchemin}" />
    </Style>
    <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Nuit}" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.overlay">
      <Setter Property="Background" Value="#D90E0F11" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Width" Value="620" />
      <Setter Property="MaxHeight" Value="620" />
      <Setter Property="Margin" Value="0,70,0,40" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="Background" Value="{StaticResource Graphite}" />
      <Setter Property="BorderBrush" Value="#3A3F45" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BoxShadow" Value="0 24 60 0 #99000000" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <ScrollViewer>
      <StackPanel Margin="40,26,40,28" Spacing="18" MaxWidth="1000">
        <StackPanel Spacing="4">
          <TextBlock Classes="eyebrow" Text="PARAMÈTRES" />
          <TextBlock Text="Modèles" FontSize="26" FontWeight="SemiBold" LetterSpacing="-0.5" />
        </StackPanel>

        <!-- Messages -->
        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Cinabre}" FontSize="13" TextWrapping="Wrap"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding Info}" Foreground="{StaticResource VertDeGris}" FontSize="13" TextWrapping="Wrap"
                   IsVisible="{Binding Info, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Le modèle par défaut : un seul gros choix, comme la barre de modèle d'opencode. -->
        <Border Classes="card">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
            <Border Width="52" Height="52" CornerRadius="26" Background="#1A5E9E92" VerticalAlignment="Center">
              <Ellipse Classes="pulse" Width="14" Height="14" Fill="{StaticResource VertDeGris}" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
              <TextBlock Classes="eyebrow" Text="MODÈLE PAR DÉFAUT" />
              <TextBlock FontSize="22" FontWeight="SemiBold" LetterSpacing="-0.3"
                         Text="{Binding DefaultModel.Model.Name, FallbackValue='Aucun modèle', TargetNullValue='Aucun modèle'}" />
              <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding DefaultModel, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Classes="mono" FontSize="12" Foreground="{StaticResource Pierre}" Text="{Binding DefaultModel.ProviderName}" />
                <TextBlock Classes="mono" FontSize="12" Foreground="{StaticResource Cendre}" Text="{Binding DefaultModel.Context}" />
                <TextBlock Classes="mono" FontSize="12" Foreground="{StaticResource Cendre}" Text="{Binding DefaultModel.Price}" />
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="2" Classes="action primary" Content="Changer" Command="{Binding OpenPickerCommand}" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- Un modèle par agent : le sien, ou celui par défaut. -->
        <StackPanel Spacing="10">
          <TextBlock Classes="eyebrow" Text="PAR AGENT" />
          <ItemsControl ItemsSource="{Binding Agents}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel ItemSpacing="12" LineSpacing="12" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:AgentModelRow">
                <Border Classes="card" Width="456" Padding="16">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" />
                      <TextBlock Classes="mono" FontSize="12" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                 Foreground="{Binding HasOwn, Converter={x:Static views:SettingsTexts.OwnBrush}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Button Classes="action" Content="Par défaut" IsVisible="{Binding HasOwn}"
                              Command="{Binding $parent[UserControl].((core:SettingsViewModel)DataContext).ResetAgentCommand}" CommandParameter="{Binding}" />
                      <Button Classes="action" Content="Changer"
                              Command="{Binding $parent[UserControl].((core:SettingsViewModel)DataContext).OpenAgentPickerCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Les fournisseurs connectés -->
        <StackPanel Spacing="10">
          <TextBlock Classes="eyebrow" Text="FOURNISSEURS" />
          <ItemsControl ItemsSource="{Binding Connections}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel ItemSpacing="12" LineSpacing="12" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="contracts:LlmConnectionDto">
                <Border Classes="card" Width="300" Padding="16"
                        Classes.revoked="{Binding RevokedAt, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="mono" FontSize="11.5" Foreground="{StaticResource Pierre}" Text="{Binding ProviderName}" />
                        <TextBlock Classes="mono" FontSize="11.5" Foreground="{StaticResource Cendre}" Text="{Binding Last4, StringFormat='…{0}'}"
                                   IsVisible="{Binding Last4, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      </StackPanel>
                      <TextBlock Classes="mono" FontSize="11" Foreground="{StaticResource Cendre}" Text="{Binding BaseUrl}" TextTrimming="CharacterEllipsis"
                                 IsVisible="{Binding BaseUrl, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <TextBlock Classes="mono" FontSize="11" Foreground="{StaticResource Cinabre}" Text="révoqué"
                                 IsVisible="{Binding RevokedAt, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="action danger" Content="Révoquer" VerticalAlignment="Top"
                            IsVisible="{Binding RevokedAt, Converter={x:Static ObjectConverters.IsNull}}"
                            Command="{Binding $parent[UserControl].((core:SettingsViewModel)DataContext).AskRevokeCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="action" Content="＋  Connecter un fournisseur" Command="{Binding OpenConnectCommand}" />
        </StackPanel>

        <!-- Confirmation : révoquer est irréversible. -->
        <Border Padding="14" CornerRadius="14" Background="#0FD9654B" BorderBrush="#66D9654B" BorderThickness="1"
                IsVisible="{Binding PendingRevoke, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="3">
              <TextBlock FontSize="13.5" FontWeight="Medium" TextWrapping="Wrap"
                         Text="{Binding PendingRevoke.Label, StringFormat='Révoquer « {0} » ?'}" />
              <TextBlock Text="La clé chiffrée est effacée du serveur. C’est définitif." FontSize="12" Foreground="{StaticResource Pierre}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Classes="action" Content="Annuler" Command="{Binding CancelRevokeCommand}" />
              <Button Classes="action danger" Content="Révoquer" Command="{Binding ConfirmRevokeCommand}" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Le sélecteur de modèles : recherche, puis un clic. -->
    <Border Classes="overlay" IsVisible="{Binding IsPickerOpen}">
      <Border Classes="panel">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,0,12">
            <TextBox Classes="field" Text="{Binding ModelQuery}" PlaceholderText="Rechercher un modèle ou un fournisseur" />
            <Button Grid.Column="1" Classes="action" Content="Fermer" Command="{Binding ClosePickerCommand}" />
          </Grid>
          <TextBlock DockPanel.Dock="Top" Text="Aucun modèle : connecte d’abord un fournisseur." FontSize="13" Foreground="{StaticResource Cendre}"
                     Margin="4,8" IsVisible="{Binding !FilteredModels.Count}" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding FilteredModels}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:ModelItem">
                  <Button Classes="row" Command="{Binding $parent[UserControl].((core:SettingsViewModel)DataContext).ChooseCommand}" CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <!-- Le modèle par défaut actuel -->
                          <Ellipse Width="7" Height="7" Fill="{StaticResource VertDeGris}" VerticalAlignment="Center" IsVisible="{Binding IsDefault}" />
                          <TextBlock Text="{Binding Model.Name}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Classes="mono" FontSize="11.5" Foreground="{StaticResource Cendre}" Text="{Binding ProviderName}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Classes="chip" Background="#1AD8B86E" IsVisible="{Binding Model.Reasoning}">
                          <TextBlock Text="raisonne" FontSize="11" Foreground="{StaticResource Laiton}" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Classes="mono" FontSize="11.5" Foreground="{StaticResource Cendre}" Text="{Binding Context}" VerticalAlignment="Center" />
                        <TextBlock Classes="mono" FontSize="11.5" Foreground="{StaticResource Pierre}" Text="{Binding Price}" VerticalAlignment="Center"
                                   IsVisible="{Binding !Model.Free}" />
                        <Border Classes="chip" Background="#1A5E9E92" IsVisible="{Binding Model.Free}">
                          <TextBlock Text="gratuit" FontSize="11" Foreground="{StaticResource VertDeGris}" VerticalAlignment="Center" />
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- Connecter un fournisseur : le choisir, puis sa clé ou son adresse. -->
    <Border Classes="overlay" IsVisible="{Binding IsConnectOpen}">
      <Border Classes="panel">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,0,12">
            <TextBox Classes="field" Text="{Binding ProviderQuery}" PlaceholderText="Rechercher un fournisseur"
                     IsVisible="{Binding Connecting, Converter={x:Static ObjectConverters.IsNull}}" />
            <TextBlock FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Connecting.Name}"
                       IsVisible="{Binding Connecting, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Button Grid.Column="1" Classes="action" Content="Fermer" Command="{Binding CloseConnectCommand}" />
          </Grid>

          <!-- Le formulaire -->
          <StackPanel DockPanel.Dock="Top" Spacing="10" IsVisible="{Binding Connecting, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBox Classes="field" Text="{Binding NewLabel}" PlaceholderText="Libellé" MaxLength="60" />
            <TextBox Classes="field" Text="{Binding NewBaseUrl}" PlaceholderText="https://…/v1" FontFamily="{StaticResource Mono}"
                     IsVisible="{Binding HasAddress}" />
            <!-- Saisie masquée ; la valeur est effacée dès l'envoi. -->
            <TextBox Classes="field" Text="{Binding NewKey}" PasswordChar="•" FontFamily="{StaticResource Mono}"
                     PlaceholderText="{Binding NeedsKey, Converter={x:Static views:SettingsTexts.KeyPlaceholder}}" />
            <Button Classes="action primary" Content="Connecter" Command="{Binding ConnectCommand}" HorizontalAlignment="Right" />
          </StackPanel>

          <!-- La liste des fournisseurs -->
          <ScrollViewer IsVisible="{Binding Connecting, Converter={x:Static ObjectConverters.IsNull}}">
            <ItemsControl ItemsSource="{Binding FilteredProviders}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="contracts:LlmProviderDto">
                  <Button Classes="row" Command="{Binding $parent[UserControl].((core:SettingsViewModel)DataContext).PickCommand}" CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="mono" FontSize="11.5" Foreground="{StaticResource Cendre}" VerticalAlignment="Center"
                                 Text="{Binding Kind, Converter={x:Static views:SettingsTexts.KindLabel}}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
