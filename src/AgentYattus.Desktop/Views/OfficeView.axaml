<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:AgentYattus.Client.Core"
             xmlns:views="using:AgentYattus.Desktop.Views"
             xmlns:conv="using:AgentYattus.Desktop.Converters"
             x:Class="AgentYattus.Desktop.Views.OfficeView" Classes="screen"
             x:DataType="core:OfficeViewModel"
             Foreground="{StaticResource Parchemin}">

  <!--
    L'open space d'une mission (ADR 0012, maquette « Bureau des agents ») : les collègues à leur bureau, leurs bulles,
    ce qui passe de l'un à l'autre, et votre bureau vitré. La scène est dessinée sur un plan fixe de 1016 × 804
    (les trajets de OfficeViewModel en dépendent) et s'adapte à la fenêtre par un Viewbox.
  -->
  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="LetterSpacing" Value="1.4" />
      <Setter Property="Foreground" Value="#8A857B" />
    </Style>
    <!-- region:desks -->
    <!-- Les deux poses d'un collègue : « travaille » s'efface quand il parle, « parle » apparaît. -->
    <Style Selector="Image.work, Image.talk">
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.25" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Image.talk"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="Panel.speaking Image.talk"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="Panel.speaking Image.work"><Setter Property="Opacity" Value="0" /></Style>
    <!-- /region -->
    <!-- region:bubble -->
    <!-- La bulle : elle apparaît en grossissant depuis la tête, et le curseur clignote pendant l'écriture. -->
    <Style Selector="Canvas.cloud">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="RenderTransform" Value="scale(0.6)" />
      <Setter Property="RenderTransformOrigin" Value="20%,100%" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="BackEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Panel.speaking Canvas.cloud">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <Style Selector="Rectangle.caret">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- /region -->
    <!-- region:knock -->
    <Style Selector="Border.office">
      <Setter Property="BorderBrush" Value="#2A2D31" />
      <Setter Property="Background" Value="#05ECE6D8" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.3" />
          <BrushTransition Property="Background" Duration="0:0:0.3" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.office.knocking">
      <Setter Property="BorderBrush" Value="{StaticResource Laiton}" />
      <Setter Property="Background" Value="#0DD8B86E" />
    </Style>
    <Style Selector="Border.knock">
      <Style.Animations>
        <Animation Duration="0:0:1.6" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.82" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- /region -->
    <!-- region:feed -->
    <Style Selector="Border.message">
      <Style.Animations>
        <Animation Duration="0:0:0.35" Easing="CubicEaseOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="8" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- /region -->
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- region:desks -->
    <!-- Un bureau : le collègue (deux poses), le meuble, sa plaque et son statut. -->
    <DataTemplate x:Key="Desk" x:DataType="core:DeskViewModel">
      <Panel Width="240" Height="350" Classes.speaking="{Binding IsSpeaking}">
        <!-- region:bubble -->
        <Canvas Classes="cloud" Width="290" Height="124" Margin="120,-112,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                Effect="drop-shadow(0 12 24 #80000000)" ZIndex="8">
          <Rectangle Canvas.Left="24" Canvas.Top="28" Width="242" Height="58" RadiusX="29" RadiusY="29" Fill="#ECE6D8" />
          <Ellipse Canvas.Left="36" Canvas.Top="16" Width="52" Height="52" Fill="#ECE6D8" />
          <Ellipse Canvas.Left="82" Canvas.Top="0" Width="56" Height="56" Fill="#ECE6D8" />
          <Ellipse Canvas.Left="136" Canvas.Top="-4" Width="60" Height="60" Fill="#ECE6D8" />
          <Ellipse Canvas.Left="196" Canvas.Top="10" Width="52" Height="52" Fill="#ECE6D8" />
          <Ellipse Canvas.Left="230" Canvas.Top="36" Width="44" Height="44" Fill="#ECE6D8" />
          <Ellipse Canvas.Left="18" Canvas.Top="42" Width="44" Height="44" Fill="#ECE6D8" />
          <Ellipse Canvas.Left="74" Canvas.Top="54" Width="44" Height="44" Fill="#ECE6D8" />
          <Ellipse Canvas.Left="122" Canvas.Top="54" Width="52" Height="52" Fill="#ECE6D8" />
          <Ellipse Canvas.Left="182" Canvas.Top="52" Width="48" Height="48" Fill="#ECE6D8" />
          <Ellipse Canvas.Left="51" Canvas.Top="101" Width="14" Height="14" Fill="#ECE6D8" />
          <Ellipse Canvas.Left="44" Canvas.Top="116" Width="8" Height="8" Fill="#ECE6D8" />
          <WrapPanel Canvas.Left="40" Canvas.Top="22" Width="212" Height="72" VerticalAlignment="Center">
            <TextBlock Text="{Binding Bubble}" Foreground="#16181B" FontSize="12.5" FontWeight="Medium" LineHeight="17" TextWrapping="Wrap"
                       MaxWidth="206" VerticalAlignment="Center" />
          </WrapPanel>
          <Rectangle Classes="caret" Canvas.Left="40" Canvas.Top="98" Width="14" Height="2" Fill="{StaticResource VertDeGris}" />
        </Canvas>
        <!-- /region -->
        <Panel Width="240" Height="240" VerticalAlignment="Top" HorizontalAlignment="Left">
          <Image Classes="work" Source="{Binding WorkImage, Converter={x:Static conv:BytesToBitmapConverter.Instance}}" Stretch="Uniform" />
          <Image Classes="talk" Source="{Binding TalkImage, Converter={x:Static conv:BytesToBitmapConverter.Instance}}" Stretch="Uniform" />
          <!-- Siège libre : aucun collègue n'occupe ce rôle dans le projet. -->
          <Panel IsVisible="{Binding IsEmpty}" Margin="40,40,40,20">
            <Rectangle RadiusX="16" RadiusY="16" Stroke="#3A3F45" StrokeThickness="1" StrokeDashArray="4,4" />
            <TextBlock Classes="label" Text="SIÈGE LIBRE" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>
        </Panel>
        <Border Margin="0,236,0,0" Height="34" VerticalAlignment="Top" CornerRadius="0,0,8,8" Background="#17191D"
                BorderBrush="#23262B" BorderThickness="1,0,1,1" />
        <StackPanel Margin="0,280,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Spacing="4">
          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Classes="label" Text="{Binding RoleLabel}" HorizontalAlignment="Center" />
          <Border Margin="0,2,0,0" Height="22" Padding="9,0" CornerRadius="11" Background="#16181B" BorderBrush="#23262B" BorderThickness="1"
                  HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Ellipse Width="6" Height="6" Fill="{StaticResource VertDeGris}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{StaticResource Pierre}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Panel>
    </DataTemplate>
    <!-- /region -->
  </UserControl.Resources>

  <DockPanel>
  <!-- La barre de l'open space (maquette, artboard Main) : la marque (retour à l'accueil), la mission, l'équipe et « Recruter ». -->
  <Border DockPanel.Dock="Top" Height="64" Padding="24,0">
    <Grid ColumnDefinitions="260,*,260" ColumnSpacing="16">
      <Button Classes="bare" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip.Tip="Retour à l’accueil"
              Command="{Binding $parent[Window].((core:ShellViewModel)DataContext).GoHomeCommand}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Width="30" Height="30" CornerRadius="8" BorderBrush="#2A2D31" BorderThickness="1" Background="#131417">
            <Viewbox Width="17" Height="17">
              <Canvas Width="24" Height="24">
                <Path Data="M5 3.5 12 11l7-7.5M12 11v9.5" Stroke="{StaticResource VertDeGris}" StrokeThickness="2" StrokeLineCap="Round" />
                <Ellipse Canvas.Left="9.8" Canvas.Top="8.8" Width="4.4" Height="4.4" Fill="{StaticResource VertDeGris}" />
              </Canvas>
            </Viewbox>
          </Border>
          <TextBlock Text="Agent Yattus" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <!-- La mission : son objectif, son projet, son état -->
      <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Height="38" Padding="16,0,8,0" CornerRadius="12"
              BorderBrush="{StaticResource Filet}" BorderThickness="1" Background="#131417">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="{Binding Mission.Mission.Goal}" FontSize="13" FontWeight="SemiBold" MaxWidth="420" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <TextBlock Classes="mono" Text="{Binding ProjectName}" FontSize="11.5" Foreground="{StaticResource Pierre}" VerticalAlignment="Center"
                     IsVisible="{Binding ProjectName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Border Height="24" Padding="9,0" CornerRadius="12" Background="{Binding Mission.Mission.Status, Converter={x:Static views:Chip.Bg}}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Ellipse Classes="live" Width="6" Height="6" Fill="{Binding Mission.Mission.Status, Converter={x:Static views:Chip.Fg}}" />
              <TextBlock Classes="mono" Text="{Binding Mission.Mission.Status, Converter={x:Static views:Chip.Label}}" FontSize="10" LetterSpacing="1"
                         Foreground="{Binding Mission.Mission.Status, Converter={x:Static views:Chip.Fg}}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- L'équipe en visages, et « Recruter » -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="-8" VerticalAlignment="Center">
          <views:Avatar Image="{Binding Leader.WorkImage}" Label="{Binding Leader.Name}" Size="28" Background="{StaticResource Obsidienne}" />
          <views:Avatar Image="{Binding Analyst.WorkImage}" Label="{Binding Analyst.Name}" Size="28" Background="{StaticResource Obsidienne}" />
          <views:Avatar Image="{Binding Writer.WorkImage}" Label="{Binding Writer.Name}" Size="28" Background="{StaticResource Obsidienne}" />
        </StackPanel>
        <Button Classes="square" Command="{Binding RecruitCommand}" Padding="14,0" Height="36" IsVisible="{Binding CanRecruit}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Data="M12,5 L12,19 M5,12 L19,12" Stroke="{StaticResource Parchemin}" StrokeThickness="2" StrokeLineCap="Round"
                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Text="Recruter" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Border>

  <Grid ColumnDefinitions="*,352" ColumnSpacing="24" Margin="24,8,24,24">

    <Grid>
      <!-- region:decor -->
      <Border CornerRadius="16" BorderBrush="#1F2226" BorderThickness="1" ClipToBounds="True">
        <Border.Background>
          <VisualBrush TileMode="Tile" SourceRect="0,0,48,48" DestinationRect="0,0,48,48">
            <VisualBrush.Visual>
              <Canvas Width="48" Height="48" Background="#0F1013">
                <Rectangle Width="48" Height="1" Fill="#08ECE6D8" />
                <Rectangle Width="1" Height="48" Fill="#08ECE6D8" />
              </Canvas>
            </VisualBrush.Visual>
          </VisualBrush>
        </Border.Background>
        <Viewbox Stretch="Uniform">
          <Canvas Width="1016" Height="804" ClipToBounds="True">
            <!-- Le mur du fond, ses fenêtres et l'horloge -->
            <Border Width="1016" Height="150" Background="#141619" BorderBrush="#23262B" BorderThickness="0,0,0,1" />
            <TextBlock Classes="label" Canvas.Left="36" Canvas.Top="30" Text="ÉQUIPE" LetterSpacing="2.4" />
            <TextBlock Canvas.Left="36" Canvas.Top="48" Text="Open space" FontSize="20" FontWeight="SemiBold" LetterSpacing="-0.4" />
            <Grid Canvas.Left="240" Canvas.Top="22" Width="520" Height="92" ColumnDefinitions="*,*,*" ColumnSpacing="10">
              <Border CornerRadius="6" BorderBrush="#262A2F" BorderThickness="1" Background="#101216" ClipToBounds="True">
                <Canvas>
                  <Rectangle Canvas.Left="12" Canvas.Top="42" Width="22" Height="48" Fill="#181B1F" />
                  <Rectangle Canvas.Left="40" Canvas.Top="26" Width="30" Height="64" Fill="#16191D" />
                  <Rectangle Canvas.Left="78" Canvas.Top="52" Width="18" Height="38" Fill="#181B1F" />
                  <Rectangle Canvas.Left="104" Canvas.Top="34" Width="36" Height="56" Fill="#15181C" />
                </Canvas>
              </Border>
              <Border Grid.Column="1" CornerRadius="6" BorderBrush="#262A2F" BorderThickness="1" Background="#101216" ClipToBounds="True">
                <Canvas>
                  <Ellipse Canvas.Left="120" Canvas.Top="14" Width="12" Height="12" Fill="#2A2A24" />
                  <Rectangle Canvas.Left="8" Canvas.Top="20" Width="34" Height="70" Fill="#16191D" />
                  <Rectangle Canvas.Left="50" Canvas.Top="46" Width="24" Height="44" Fill="#181B1F" />
                  <Rectangle Canvas.Left="82" Canvas.Top="32" Width="40" Height="58" Fill="#15181C" />
                </Canvas>
              </Border>
              <Border Grid.Column="2" CornerRadius="6" BorderBrush="#262A2F" BorderThickness="1" Background="#101216" ClipToBounds="True">
                <Canvas>
                  <Rectangle Canvas.Left="16" Canvas.Top="38" Width="28" Height="52" Fill="#181B1F" />
                  <Rectangle Canvas.Left="52" Canvas.Top="16" Width="20" Height="74" Fill="#16191D" />
                  <Rectangle Canvas.Left="80" Canvas.Top="50" Width="44" Height="40" Fill="#15181C" />
                </Canvas>
              </Border>
            </Grid>

            <!-- Les archives : le workspace, d'où viennent les dossiers -->
            <Border Canvas.Left="30" Canvas.Top="118" Width="138" Height="258" CornerRadius="8" Background="#17191D" BorderBrush="#2A2D31"
                    BorderThickness="1" Padding="10,12">
              <UniformGrid Rows="4">
                <Border BorderBrush="#23262B" BorderThickness="0,0,0,2" Margin="0,0,0,8">
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                    <Rectangle Width="12" Height="38" RadiusX="2" RadiusY="2" Fill="#2C3035" /><Rectangle Width="14" Height="44" RadiusX="2" RadiusY="2" Fill="#363B41" />
                    <Rectangle Width="10" Height="34" RadiusX="2" RadiusY="2" Fill="#2C3035" /><Rectangle Width="16" Height="40" RadiusX="2" RadiusY="2" Fill="#3A3F45" />
                    <Rectangle Width="12" Height="42" RadiusX="2" RadiusY="2" Fill="#2C3035" />
                  </StackPanel>
                </Border>
                <Border BorderBrush="#23262B" BorderThickness="0,0,0,2" Margin="0,0,0,8">
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                    <Rectangle Width="14" Height="40" RadiusX="2" RadiusY="2" Fill="#33383E" /><Rectangle Width="18" Height="44" RadiusX="2" RadiusY="2" Fill="{StaticResource VertDeGris}" />
                    <Rectangle Width="12" Height="38" RadiusX="2" RadiusY="2" Fill="#2C3035" /><Rectangle Width="14" Height="42" RadiusX="2" RadiusY="2" Fill="#3A3F45" />
                    <Rectangle Width="10" Height="34" RadiusX="2" RadiusY="2" Fill="#2C3035" />
                  </StackPanel>
                </Border>
                <Border BorderBrush="#23262B" BorderThickness="0,0,0,2" Margin="0,0,0,8">
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                    <Rectangle Width="16" Height="42" RadiusX="2" RadiusY="2" Fill="#363B41" /><Rectangle Width="12" Height="36" RadiusX="2" RadiusY="2" Fill="#2C3035" />
                    <Rectangle Width="14" Height="44" RadiusX="2" RadiusY="2" Fill="#3A3F45" /><Rectangle Width="12" Height="40" RadiusX="2" RadiusY="2" Fill="#2C3035" />
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                  <Rectangle Width="12" Height="40" RadiusX="2" RadiusY="2" Fill="#2C3035" /><Rectangle Width="16" Height="36" RadiusX="2" RadiusY="2" Fill="#363B41" />
                  <Rectangle Width="14" Height="42" RadiusX="2" RadiusY="2" Fill="#2C3035" /><Rectangle Width="12" Height="38" RadiusX="2" RadiusY="2" Fill="#3A3F45" />
                </StackPanel>
              </UniformGrid>
            </Border>
            <TextBlock Classes="label" Canvas.Left="30" Canvas.Top="386" Width="138" TextAlignment="Center" Text="ARCHIVES · WORKSPACE" />

            <!-- Une plante, pour que ce soit un bureau -->
            <Canvas Canvas.Left="960" Canvas.Top="160" Width="54" Height="90">
              <Path Data="M27,56 C25,42 13,36 5,36 C7,48 15,56 27,56 Z M27,52 C29,36 39,26 49,24 C47,38 39,50 27,52 Z M27,50 C23,36 27,22 33,14 C37,26 35,40 27,50 Z" Fill="#2F5A52" />
              <Path Data="M14,56 L40,56 L36,86 L18,86 Z" Fill="#24272C" />
            </Canvas>

            <!-- region:desks -->
            <ContentControl ClipToBounds="False" Canvas.Left="40" Canvas.Top="440" ZIndex="{Binding Leader.Layer}" Content="{Binding Leader}" ContentTemplate="{StaticResource Desk}" />
            <ContentControl ClipToBounds="False" Canvas.Left="210" Canvas.Top="160" ZIndex="{Binding Analyst.Layer}" Content="{Binding Analyst}" ContentTemplate="{StaticResource Desk}" />
            <ContentControl ClipToBounds="False" Canvas.Left="520" Canvas.Top="160" ZIndex="{Binding Writer.Layer}" Content="{Binding Writer}" ContentTemplate="{StaticResource Desk}" />
            <!-- /region -->

            <!-- Votre bureau vitré -->
            <Border Classes="office" Classes.knocking="{Binding IsKnocking}" Canvas.Left="700" Canvas.Top="470" Width="292" Height="318"
                    CornerRadius="12" BorderThickness="1" ClipToBounds="True">
              <Panel>
                <TextBlock Classes="label" Margin="14,12,0,0" Text="BUREAU · VOUS" />
                <!-- region:desks -->
                <Panel Width="200" Height="200" Margin="0,22,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                  <Image Source="{Binding Manager.WorkImage, Converter={x:Static conv:BytesToBitmapConverter.Instance}}" Stretch="Uniform" />
                </Panel>
                <Border Width="200" Height="26" Margin="0,218,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="0,0,8,8"
                        Background="#1B1A17" BorderBrush="#2A2924" BorderThickness="1,0,1,1" />
                <StackPanel Margin="0,256,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Spacing="4">
                  <TextBlock Text="Vous" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Classes="label" Text="RESPONSABLE" Foreground="{StaticResource Laiton}" HorizontalAlignment="Center" />
                </StackPanel>
                <!-- /region -->
              </Panel>
            </Border>

            <!-- region:carry -->
            <!-- Ce qui passe d'un bureau à l'autre : la position vient de OfficeViewModel (courbe douce). -->
            <StackPanel Canvas.Left="{Binding TokenX}" Canvas.Top="{Binding TokenY}" IsVisible="{Binding IsCarrying}" Spacing="4"
                        RenderTransform="translate(-40px, -16px)" Width="80" ZIndex="9">
              <Path Data="M1,4 C1,2.3 2.3,1 4,1 L12,1 L15,4 L30,4 C31.7,4 33,5.3 33,7 L33,22 C33,23.7 31.7,25 30,25 L4,25 C2.3,25 1,23.7 1,22 Z"
                    Fill="{StaticResource VertDeGris}" Width="34" Height="26" HorizontalAlignment="Center" Effect="drop-shadow(0 6 10 #80000000)" />
              <Border Padding="6,2" CornerRadius="4" Background="#0B0C0E" HorizontalAlignment="Center">
                <TextBlock Classes="mono" Text="{Binding CarryLabel}" FontSize="10" Foreground="{StaticResource VertDeGris}" MaxWidth="160"
                           TextTrimming="CharacterEllipsis" />
              </Border>
            </StackPanel>
            <!-- /region -->

            <!-- region:knock -->
            <!-- On frappe à votre porte : la demande d'accord, au-dessus du bureau vitré. -->
            <Border Classes="knock" Canvas.Left="762" Canvas.Top="330" Width="236" Padding="16,14" CornerRadius="12" Background="#17150F"
                    BorderBrush="{StaticResource Laiton}" BorderThickness="1" IsVisible="{Binding IsKnocking}" ZIndex="10"
                    BoxShadow="0 24 48 -20 #CC000000">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding Writer.Name, StringFormat='{}{0} frappe à votre porte'}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource Laiton}" TextWrapping="Wrap" />
                <TextBlock Text="Il veut écrire dans le workspace. Relisez tout avant de décider." FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource Parchemin}" />
                <Button Classes="gold" Command="{Binding OpenReviewCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="34">
                  <TextBlock Text="Voir et décider" FontSize="12.5" FontWeight="SemiBold" />
                </Button>
              </StackPanel>
            </Border>
            <!-- /region -->
          </Canvas>
        </Viewbox>
      </Border>
      <!-- /region -->

      <!-- region:knock -->
      <!-- La relecture : exactement ce qui sera écrit. « Approuver » reste désactivé tant que tout n'a pas été affiché (leçon 26). -->
      <Border Grid.Row="1" IsVisible="{Binding IsReviewing}" Background="#B30B0C0E" CornerRadius="16">
        <Border Width="520" MaxHeight="620" Padding="22" CornerRadius="16" Background="{StaticResource Graphite}" BorderBrush="{StaticResource Laiton}"
                BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 30 90 0 #8C000000">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="DEMANDE D'ACCORD" Foreground="{StaticResource Laiton}" />
              <TextBlock Text="{Binding Writer.Name, StringFormat='{}{0} veut écrire ceci'}" FontSize="20" FontWeight="SemiBold" />
            </StackPanel>
            <ScrollViewer Grid.Row="1">
              <ItemsControl ItemsSource="{Binding Mission.PendingApproval}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="core:ApprovalItem">
                    <StackPanel Spacing="10" Margin="0,0,0,12">
                      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Classes="mono" Text="{Binding Target}" FontSize="12" Foreground="{StaticResource Pierre}" TextWrapping="Wrap"
                                 IsVisible="{Binding Target, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <TextBlock Text="{Binding Warning}" FontSize="12" Foreground="{StaticResource Cinabre}" TextWrapping="Wrap"
                                 IsVisible="{Binding Warning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <Border Padding="12,10" CornerRadius="10" Background="{StaticResource Obsidienne}" BorderBrush="{StaticResource Filet}" BorderThickness="1">
                        <StackPanel>
                          <ItemsControl ItemsSource="{Binding Preview}"
                                        IsVisible="{Binding !$parent[UserControl].((core:OfficeViewModel)DataContext).Mission.AllShown}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <TextBlock Classes="mono" Text="{Binding StringFormat='+ {0}'}" FontSize="12" LineHeight="20" TextWrapping="Wrap" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <ItemsControl ItemsSource="{Binding AllLines}"
                                        IsVisible="{Binding $parent[UserControl].((core:OfficeViewModel)DataContext).Mission.AllShown}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <TextBlock Classes="mono" Text="{Binding StringFormat='+ {0}'}" FontSize="12" LineHeight="20" TextWrapping="Wrap" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Classes="mono" FontSize="12" Foreground="{StaticResource Cendre}" IsVisible="{Binding HasMoreLines}"
                                     Text="{Binding MoreLines, StringFormat='  +{0} lignes'}" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
              <Button Classes="outline" Command="{Binding Mission.ShowAllCommand}" IsVisible="{Binding Mission.NeedsFullReview}" Height="36" Padding="12,0">
                <TextBlock Text="Tout afficher" FontSize="12.5" />
              </Button>
              <Button Grid.Column="1" Classes="outline" Command="{Binding CloseReviewCommand}" Height="36" Padding="12,0">
                <TextBlock Text="Plus tard" FontSize="12.5" />
              </Button>
              <Button Grid.Column="2" Classes="outline" Command="{Binding Mission.RefuseCommand}" Height="36" Padding="12,0">
                <TextBlock Text="Refuser" FontSize="12.5" />
              </Button>
              <Button Grid.Column="3" Classes="gold" Command="{Binding Mission.ApproveCommand}" Height="36" Padding="14,0">
                <TextBlock Text="Approuver" FontSize="12.5" FontWeight="SemiBold" />
              </Button>
            </Grid>
          </Grid>
        </Border>
      </Border>
      <!-- /region -->
    </Grid>

    <!-- region:feed -->
    <!-- Le fil de l'équipe : l'historique des répliques, comme une messagerie d'entreprise. -->
    <Border Grid.Column="1" CornerRadius="16" Background="#121316" BorderBrush="#1F2226" BorderThickness="1">
      <Grid RowDefinitions="58,*,Auto">
        <Border BorderBrush="#1F2226" BorderThickness="0,0,0,1" Padding="16,0">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="Fil de l'équipe" FontSize="13.5" FontWeight="SemiBold" />
              <TextBlock Classes="mono" Text="{Binding Feed.Count, StringFormat='{}{0} messages'}" FontSize="10.5" Foreground="#8A857B" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Ellipse Classes="pulse" Width="6" Height="6" Fill="{StaticResource VertDeGris}" VerticalAlignment="Center" />
              <TextBlock Classes="label" Text="EN DIRECT" Foreground="{StaticResource VertDeGris}" />
            </StackPanel>
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" x:Name="FeedScroll" Padding="16,12">
          <ItemsControl ItemsSource="{Binding Feed}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:ChatLine">
                <Border Classes="message">
                  <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                    <Border Width="32" Height="32" CornerRadius="16" ClipToBounds="True" Background="#1D2024" VerticalAlignment="Top">
                      <Canvas Width="32" Height="32">
                        <Image Canvas.Left="-16" Canvas.Top="-4" Width="64" Height="64"
                               Source="{Binding Avatar, Converter={x:Static conv:BytesToBitmapConverter.Instance}}" />
                      </Canvas>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Classes="mono" Text="{Binding Time}" FontSize="10" Foreground="#8A857B" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="{Binding Text}" FontSize="13" LineHeight="19" Foreground="#D9D3C5" TextWrapping="Wrap" />
                      <Border IsVisible="{Binding File, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" HorizontalAlignment="Left"
                              Padding="10,5" CornerRadius="7" Background="#16181B" BorderBrush="#2A2D31" BorderThickness="1">
                        <TextBlock Classes="mono" Text="{Binding File}" FontSize="11" Foreground="{StaticResource VertDeGris}" />
                      </Border>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Grid.Row="2" Margin="16,0,16,14" FontSize="12" Foreground="#8A857B"
                   Text="{Binding Typing, StringFormat='{}{0} écrit…'}" IsVisible="{Binding Typing, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </Grid>
    </Border>
    <!-- /region -->
  </Grid>
  </DockPanel>
</UserControl>
