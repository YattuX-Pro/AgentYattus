<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:AgentYattus.Client.Core"
             xmlns:contracts="using:AgentYattus.Contracts"
             xmlns:views="using:AgentYattus.Desktop.Views"
             xmlns:conv="using:AgentYattus.Desktop.Converters"
             x:Class="AgentYattus.Desktop.Views.AgentsView" Classes="screen"
             x:DataType="core:AgentsViewModel"
             Foreground="{StaticResource Parchemin}">

  <!--
    L'équipe (maquette « Bureau des agents », artboard Agents) : une carte par agent avec le visage du collègue
    qui l'incarne et ses chiffres ; à droite, sa fiche, où il se présente dans une bulle.
  -->
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#111215" />
      <Setter Property="BorderBrush" Value="#1F2226" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button:pointerover Border.card">
      <Setter Property="BorderBrush" Value="#3A3F45" />
    </Style>
    <Style Selector="Border.card.selected, Button:pointerover Border.card.selected">
      <Setter Property="BorderBrush" Value="{StaticResource VertDeGris}" />
      <Setter Property="BoxShadow" Value="0 0 0 3 #2E5E9E92" />
    </Style>
    <!-- La photo zoome doucement au survol. -->
    <Style Selector="Image.photo">
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.5" Easing="CubicEaseOut" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Button:pointerover Image.photo">
      <Setter Property="RenderTransform" Value="scale(1.05)" />
    </Style>
    <!-- La barre de réussite se remplit à l'arrivée. -->
    <Style Selector="Border.bar">
      <Style.Animations>
        <Animation Duration="0:0:0.8" Easing="CubicEaseOut">
          <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- La bulle de la fiche apparaît en grossissant. -->
    <Style Selector="Grid.cloud">
      <Setter Property="RenderTransformOrigin" Value="50%,0%" />
      <Style.Animations>
        <Animation Duration="0:0:0.4" Easing="BackEaseOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="ScaleTransform.ScaleX" Value="0.6" /><Setter Property="ScaleTransform.ScaleY" Value="0.6" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,380" Margin="40,26,40,0" ColumnSpacing="24">

    <!-- L'équipe : un vrai visage par agent, ses chiffres dessous -->
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
        <TextBlock Text="L’équipe" FontSize="22" FontWeight="SemiBold" LetterSpacing="-0.44" VerticalAlignment="Bottom" />
        <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{StaticResource Cendre}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
      </StackPanel>
      <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Foreground="{StaticResource Cinabre}" FontSize="12.5" Margin="0,0,0,10"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Tiles}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="3" ColumnSpacing="14" RowSpacing="14" VerticalAlignment="Top" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.DataTemplates>
            <DataTemplate DataType="core:AgentCard">
              <Button Classes="bare lift enter" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                      Command="{Binding $parent[ItemsControl].((core:AgentsViewModel)DataContext).SelectCommand}" CommandParameter="{Binding}">
                <Border Classes="card" Classes.selected="{Binding IsSelected}">
                  <StackPanel>
                    <!-- La photo, en haut de la carte, fondue vers le bas. -->
                    <Panel x:Name="Photo" Height="150" ClipToBounds="True" Background="#1D2024">
                      <Canvas>
                        <Image Classes="photo" Canvas.Top="-12" Width="{Binding #Photo.Bounds.Width}" Height="{Binding #Photo.Bounds.Width}"
                               Source="{Binding Face.Work, Converter={x:Static conv:BytesToBitmapConverter.Instance}}" />
                      </Canvas>
                      <TextBlock Text="{Binding Name, Converter={x:Static views:Initial.Of}}" FontSize="48" FontWeight="SemiBold"
                                 Foreground="#3A3F45" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 IsVisible="{Binding Face.Work, Converter={x:Static ObjectConverters.IsNull}}" />
                      <Border>
                        <Border.Background>
                          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#00111215" Offset="0.45" />
                            <GradientStop Color="#111215" Offset="1" />
                          </LinearGradientBrush>
                        </Border.Background>
                      </Border>
                      <!-- Ce qu'il fait en ce moment -->
                      <Border Margin="12" Height="22" Padding="9,0" CornerRadius="11" Background="#B80B0C0E"
                              HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Ellipse Width="6" Height="6" Fill="{Binding State, Converter={x:Static views:StateBrush.Of}}" />
                          <TextBlock Text="{Binding StateLabel}" FontSize="11.5" Foreground="{Binding State, Converter={x:Static views:StateBrush.Of}}" />
                        </StackPanel>
                      </Border>
                      <Border Margin="12" Height="22" Padding="8,0" CornerRadius="11" Background="#B80B0C0E"
                              HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding IsCustom}">
                        <TextBlock Classes="mono" Text="PERSO" FontSize="10" LetterSpacing="0.8" Foreground="{StaticResource Pierre}" VerticalAlignment="Center" />
                      </Border>
                      <!-- Le chef d'équipe (leçon 129) : pas encore dans la maquette ; même pastille que « PERSO », en vert-de-gris. -->
                      <Border Margin="12" Height="22" Padding="8,0" CornerRadius="11" Background="#B80B0C0E"
                              HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding IsLeader}">
                        <TextBlock Classes="mono" Text="CHEF D’ÉQUIPE" FontSize="10" LetterSpacing="0.8" Foreground="{StaticResource VertDeGris}" VerticalAlignment="Center" />
                      </Border>
                    </Panel>
                    <StackPanel Spacing="12" Margin="16,4,16,16">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Agent.Name}" FontSize="12.5" Foreground="{StaticResource Cendre}" />
                      </StackPanel>
                      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <StackPanel Spacing="2">
                          <TextBlock Classes="mono" Text="{Binding Missions}" FontSize="15" />
                          <TextBlock Text="missions" FontSize="11" Foreground="{StaticResource Cendre}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Classes="mono" Text="{Binding RateLabel}" FontSize="15"
                                     Foreground="{Binding Rate, Converter={x:Static views:RateBrush.Of}}" />
                          <TextBlock Text="réussite" FontSize="11" Foreground="{StaticResource Cendre}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                          <TextBlock Classes="mono" Text="{Binding Cost}" FontSize="15" />
                          <TextBlock Text="par mission" FontSize="11" Foreground="{StaticResource Cendre}" />
                        </StackPanel>
                      </Grid>
                      <Border x:Name="Track" Height="4" CornerRadius="2" Background="#1F2226" ClipToBounds="True">
                        <Border Classes="bar" HorizontalAlignment="Left" CornerRadius="2" RenderTransformOrigin="0%,50%"
                                Background="{Binding Rate, Converter={x:Static views:RateBrush.Of}}">
                          <Border.Width>
                            <MultiBinding Converter="{x:Static views:RateBrush.Share}">
                              <Binding Path="Rate" />
                              <Binding ElementName="Track" Path="Bounds.Width" />
                            </MultiBinding>
                          </Border.Width>
                        </Border>
                      </Border>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>
            <!-- Recruter un collègue : une tuile en pointillés -->
            <DataTemplate DataType="core:RecruitTile">
              <Button Classes="bare lift enter" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Foreground="{StaticResource Cendre}"
                      Command="{Binding $parent[ItemsControl].((core:AgentsViewModel)DataContext).CustomizeCommand}">
                <Panel>
                  <Rectangle RadiusX="18" RadiusY="18" Stroke="#2E3237" StrokeThickness="1.5" StrokeDashArray="4,3" />
                  <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="26" BorderBrush="#2E3237" BorderThickness="1" HorizontalAlignment="Center">
                      <Path Data="M12 5v14M5 12h14" Stroke="{StaticResource Cendre}" StrokeThickness="2" StrokeLineCap="Round"
                            Width="20" Height="20" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Recruter un collègue" FontSize="14" FontWeight="Medium" Foreground="{StaticResource Cendre}" />
                  </StackPanel>
                </Panel>
              </Button>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- La fiche : il ou elle se présente -->
    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Border CornerRadius="22" VerticalAlignment="Top" ClipToBounds="True"
            Background="{StaticResource Graphite}" BorderBrush="#1F2226" BorderThickness="1"
            BoxShadow="0 24 70 0 #73000000" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel>
        <Panel Height="230" ClipToBounds="True" Background="#1D2024">
          <Canvas>
            <Image Width="378" Height="378" Canvas.Top="-20"
                   Source="{Binding Selected.Face.Talk, Converter={x:Static conv:BytesToBitmapConverter.Instance}}" />
          </Canvas>
          <Border>
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#0016181B" Offset="0.55" />
                <GradientStop Color="#16181B" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </Panel>
        <!-- La bulle descend sur le buste ; sa pointe remonte vers la bouche. -->
        <Grid Classes="cloud" Margin="22,-40,22,16"
              IsVisible="{Binding Selected.Hello, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <Path Data="M30 0 L0 72 L20 72 Z" Fill="{StaticResource Parchemin}"
                Width="30" Height="72" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="28,-70,0,0" IsHitTestVisible="False" />
          <Border Padding="13,10" CornerRadius="14" Background="{StaticResource Parchemin}">
            <TextBlock Text="{Binding Selected.Hello}" Foreground="#16181B" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" />
          </Border>
        </Grid>
        <StackPanel Spacing="18" Margin="22,4,22,22">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding Selected.Name}" FontSize="22" FontWeight="SemiBold" LetterSpacing="-0.44" />
            <TextBlock FontSize="13" Foreground="{StaticResource Pierre}" TextTrimming="CharacterEllipsis">
              <Run Text="{Binding Selected.Agent.Name}" /><Run Text=" · " /><Run Text="{Binding Selected.Agent.Model}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Cendre}" />
            </TextBlock>
          </StackPanel>

          <!-- Sa personnalité -->
          <ItemsControl ItemsSource="{Binding Selected.Traits}" IsVisible="{Binding !!Selected.Traits.Count}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Border Height="26" Padding="10,0" CornerRadius="13" BorderBrush="#665E9E92" BorderThickness="1" Background="#1A5E9E92">
                  <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel>
            <TextBlock Classes="eyebrow" Text="OUTILS" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding Selected.Agent.Tools}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="contracts:ToolInfoDto">
                  <Border Padding="0,10" BorderBrush="{StaticResource Filet}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                      <Ellipse Width="7" Height="7" Fill="#7DB5AA" IsVisible="{Binding !RequiresApproval}" VerticalAlignment="Center" />
                      <Rectangle Width="7" Height="7" RadiusX="1" RadiusY="1" Fill="{StaticResource Laiton}" RenderTransform="rotate(45deg)"
                                 IsVisible="{Binding RequiresApproval}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                                 ToolTip.Tip="{Binding Description}" />
                      <TextBlock Grid.Column="2" Text="lecture" FontSize="12" Foreground="#7DB5AA" IsVisible="{Binding !RequiresApproval}" />
                      <TextBlock Grid.Column="2" Text="avec votre accord" FontSize="12" Foreground="{StaticResource Laiton}"
                                 IsVisible="{Binding RequiresApproval}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Button Classes="primary" Height="40" HorizontalAlignment="Stretch" Command="{Binding AssignCommand}" CommandParameter="{Binding Selected}">
              <TextBlock Text="{Binding Selected.Name, StringFormat='Confier une mission à {0}'}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </Button>
            <!-- Modifier la fiche : son visage, son prénom, sa personnalité -->
            <Button Grid.Column="1" Classes="outline" Width="40" Height="40" Padding="0" Command="{Binding CustomizeCommand}" CommandParameter="{Binding Selected}"
                    IsVisible="{Binding CanCustomize}" ToolTip.Tip="Modifier la fiche : visage, prénom, personnalité"
                    AutomationProperties.Name="Modifier la fiche" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
              <Path Data="M4 20h4L19 9l-4-4L4 16zM13.5 6.5l4 4" Stroke="{StaticResource Pierre}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="16" Height="16" Stretch="Uniform" />
            </Button>
          </Grid>
        </StackPanel>
      </StackPanel>
    </Border>
    </ScrollViewer>
  </Grid>
</UserControl>
