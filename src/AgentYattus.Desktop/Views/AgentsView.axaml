<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:AgentYattus.Client.Core"
             xmlns:contracts="using:AgentYattus.Contracts"
             x:Class="AgentYattus.Desktop.Views.AgentsView"
             x:DataType="core:AgentsViewModel"
             Foreground="{StaticResource Parchemin}">

  <UserControl.Styles>
    <Style Selector="ListBox.agents">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.agents ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,18,18" />
    </Style>
    <Style Selector="ListBox.agents ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.agentCard">
      <Setter Property="Width" Value="260" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Background" Value="{StaticResource Graphite}" />
      <Setter Property="BorderBrush" Value="{StaticResource Filet}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.agentCard">
      <Setter Property="BorderBrush" Value="{StaticResource VertDeGris}" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,Auto" Margin="40,26,40,28" ColumnSpacing="24">

    <!-- Les agents, en cartes -->
    <StackPanel Spacing="16">
      <TextBlock Classes="eyebrow" Text="AGENTS" />
      <ListBox Classes="agents" ItemsSource="{Binding Agents}" SelectedItem="{Binding Selected}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="contracts:AgentDto">
            <Border Classes="agentCard">
              <StackPanel Spacing="16">
                <Grid ColumnDefinitions="Auto,*">
                  <Panel Width="52" Height="52">
                    <Ellipse Fill="{StaticResource Nuit}" Stroke="{StaticResource VertDeGris}" StrokeThickness="1.5" />
                    <Viewbox Width="24" Height="24">
                      <Canvas Width="20" Height="20">
                        <Path Data="M5 14L10 5l5 9z" Stroke="{StaticResource VertDeGris}" StrokeThickness="1.3" StrokeJoin="Round" />
                        <Ellipse Canvas.Left="8.2" Canvas.Top="3.2" Width="3.6" Height="3.6" Fill="{StaticResource Parchemin}" />
                        <Ellipse Canvas.Left="3.2" Canvas.Top="12.2" Width="3.6" Height="3.6" Fill="{StaticResource Parchemin}" />
                        <Ellipse Canvas.Left="13.2" Canvas.Top="12.2" Width="3.6" Height="3.6" Fill="{StaticResource Parchemin}" />
                      </Canvas>
                    </Viewbox>
                  </Panel>
                  <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Height="22" Padding="8,0"
                          CornerRadius="11" Background="#1A5E9E92">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Ellipse Width="6" Height="6" Fill="{StaticResource VertDeGris}" />
                      <TextBlock Text="Actif" FontSize="11.5" Foreground="{StaticResource VertDeGris}" />
                    </StackPanel>
                  </Border>
                </Grid>
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Classes="mono" Text="{Binding Model}" FontSize="12" Foreground="{StaticResource Cendre}" />
                </StackPanel>
                <TextBlock Classes="mono" FontSize="11.5" Foreground="{StaticResource Pierre}"
                           Text="{Binding MaxIterations, StringFormat='{}{0} tours max.'}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="{Binding Error}" Foreground="{StaticResource Cinabre}" FontSize="12.5"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

    <!-- Inspecteur de l'agent choisi -->
    <Border Grid.Column="1" Width="380" Padding="22" CornerRadius="22" VerticalAlignment="Top"
            Background="{StaticResource Graphite}" BorderBrush="{StaticResource Filet}" BorderThickness="1"
            BoxShadow="0 24 70 0 #73000000" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="18">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Selected.Name}" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Selected.Role}" FontSize="13" Foreground="{StaticResource Pierre}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Classes="eyebrow" Text="OUTILS" />
          <ItemsControl ItemsSource="{Binding Selected.Tools}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="contracts:ToolInfoDto">
                <Border Padding="0,10" BorderBrush="{StaticResource Filet}" BorderThickness="0,1,0,0">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource VertDeGris}" IsVisible="{Binding !RequiresApproval}" VerticalAlignment="Center" />
                    <Rectangle Width="7" Height="7" RadiusX="1" RadiusY="1" Fill="{StaticResource Laiton}" RenderTransform="rotate(45deg)"
                               IsVisible="{Binding RequiresApproval}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                               ToolTip.Tip="{Binding Description}" />
                    <TextBlock Grid.Column="2" Text="lecture" FontSize="12" Foreground="#7DB5AA" IsVisible="{Binding !RequiresApproval}" />
                    <TextBlock Grid.Column="2" Text="sensible · approbation" FontSize="12" Foreground="{StaticResource Laiton}"
                               IsVisible="{Binding RequiresApproval}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Classes="eyebrow" Text="LIMITES" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Tours de boucle" FontSize="13" Foreground="{StaticResource Pierre}" />
            <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Selected.MaxIterations}" FontSize="13" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Modèle" FontSize="13" Foreground="{StaticResource Pierre}" />
            <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Selected.Model}" FontSize="13" />
          </Grid>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
