<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:AgentYattus.Client.Core"
             xmlns:contracts="using:AgentYattus.Contracts"
             x:Class="AgentYattus.Desktop.Views.HomeView"
             x:DataType="core:HomeViewModel"
             Foreground="{StaticResource Parchemin}">

  <UserControl.Styles>
    <!-- Champ de saisie nu : le cadre est porté par la carte autour. -->
    <Style Selector="TextBox.composer, TextBox.composer:pointerover, TextBox.composer:focus">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource Parchemin}" />
    </Style>
    <Style Selector="TextBox.composer /template/ Border#PART_BorderElement,
                     TextBox.composer:pointerover /template/ Border#PART_BorderElement,
                     TextBox.composer:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.send /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource VertDeGris}" />
      <Setter Property="CornerRadius" Value="21" />
    </Style>
    <Style Selector="Button.send:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#6FB3A6" />
    </Style>
    <Style Selector="Button.send:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Filet}" />
    </Style>

    <Style Selector="ToggleButton.report /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource Filet}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Foreground" Value="{StaticResource Cendre}" />
    </Style>
    <Style Selector="ToggleButton.report:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Nuit}" />
      <Setter Property="Foreground" Value="{StaticResource Parchemin}" />
    </Style>
    <Style Selector="ToggleButton.report:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1AD8B86E" />
      <Setter Property="BorderBrush" Value="#73D8B86E" />
      <Setter Property="Foreground" Value="{StaticResource Laiton}" />
    </Style>

    <Style Selector="Button.chip /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource Filet}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Foreground" Value="{StaticResource Pierre}" />
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Graphite}" />
      <Setter Property="Foreground" Value="{StaticResource Parchemin}" />
    </Style>

    <!-- Carte de mission : couleur selon le statut. -->
    <Style Selector="Border.mission">
      <Setter Property="Background" Value="{StaticResource Graphite}" />
      <Setter Property="BorderBrush" Value="{StaticResource Filet}" />
    </Style>
    <Style Selector="Border.mission.failed">
      <Setter Property="Background" Value="#14D9654B" />
      <Setter Property="BorderBrush" Value="#66D9654B" />
    </Style>
    <Style Selector="Border.mission.completed">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- Laiton : une décision humaine est attendue. -->
    <Style Selector="Border.mission.awaiting">
      <Setter Property="Background" Value="#0FD8B86E" />
      <Setter Property="BorderBrush" Value="#73D8B86E" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <!-- Contenu centré -->
    <ScrollViewer>
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="24,48,24,28" MaxWidth="1000">

        <!-- ponytail: orbes décoratives ; à brancher sur le module Agents quand il exposera ses agents. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="36" HorizontalAlignment="Center" Margin="0,0,0,40">
          <StackPanel Spacing="10">
            <Panel Width="60" Height="60">
              <Ellipse Classes="pulse" Stroke="{StaticResource VertDeGris}" StrokeThickness="1.5" />
              <Ellipse Fill="{StaticResource Graphite}" Stroke="{StaticResource VertDeGris}" StrokeThickness="1.5" />
              <Viewbox Width="26" Height="26">
                <Canvas Width="20" Height="20">
                  <Path Data="M5 14L10 5l5 9z" Stroke="{StaticResource VertDeGris}" StrokeThickness="1.3" StrokeJoin="Round" />
                  <Ellipse Canvas.Left="8.2" Canvas.Top="3.2" Width="3.6" Height="3.6" Fill="{StaticResource Parchemin}" />
                  <Ellipse Canvas.Left="3.2" Canvas.Top="12.2" Width="3.6" Height="3.6" Fill="{StaticResource Parchemin}" />
                  <Ellipse Canvas.Left="13.2" Canvas.Top="12.2" Width="3.6" Height="3.6" Fill="{StaticResource Parchemin}" />
                </Canvas>
              </Viewbox>
            </Panel>
            <TextBlock Text="Analyste" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center" />
          </StackPanel>
          <StackPanel Spacing="10">
            <Panel Width="60" Height="60">
              <Ellipse Fill="{StaticResource Graphite}" Stroke="{StaticResource Laiton}" StrokeThickness="1.5" StrokeDashArray="3,2" />
              <Viewbox Width="26" Height="26">
                <Canvas Width="20" Height="20">
                  <Path Data="M4 6h12M4 10h12M4 14h7" Stroke="{StaticResource Parchemin}" StrokeThickness="1.4" StrokeLineCap="Round" />
                  <Ellipse Canvas.Left="13.2" Canvas.Top="12.2" Width="3.6" Height="3.6" Fill="{StaticResource Laiton}" />
                </Canvas>
              </Viewbox>
            </Panel>
            <TextBlock Text="Rédacteur" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center" />
          </StackPanel>
          <StackPanel Spacing="10">
            <Panel Width="60" Height="60">
              <Ellipse Stroke="#3A3F45" StrokeThickness="1.5" StrokeDashArray="3,2" />
              <Viewbox Width="26" Height="26">
                <Canvas Width="20" Height="20">
                  <Ellipse Canvas.Left="3.5" Canvas.Top="3.5" Width="13" Height="13" Stroke="#3A3F45" StrokeThickness="1.2" />
                  <Path Data="M10 3.5A6.5 6.5 0 0 1 16.5 10" Stroke="{StaticResource Cendre}" StrokeThickness="1.4" StrokeLineCap="Round" />
                  <Ellipse Canvas.Left="8.2" Canvas.Top="8.2" Width="3.6" Height="3.6" Fill="{StaticResource Pierre}" />
                </Canvas>
              </Viewbox>
            </Panel>
            <TextBlock Text="Chercheur" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center" Foreground="{StaticResource Pierre}" />
          </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Quelle mission aujourd’hui ?" FontSize="40" FontWeight="Medium"
                   LetterSpacing="-1.2" HorizontalAlignment="Center" Margin="0,0,0,26" />

        <!-- Composer -->
        <Border Grid.Row="2" MaxWidth="760" Padding="18,18,18,14" CornerRadius="22"
                Background="{StaticResource Graphite}" BorderBrush="#2B2F34" BorderThickness="1"
                BoxShadow="0 30 90 0 #80000000">
          <StackPanel Spacing="10">
            <TextBox Classes="composer" Text="{Binding Goal}" PlaceholderText="Décrivez l’objectif…"
                     PlaceholderForeground="#6F6B63" AcceptsReturn="True" TextWrapping="Wrap"
                     FontSize="17" MinHeight="78" Padding="4,2" />
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
              <!-- Bascule : une simple question, ou une revue à deux agents qui écrit REPORT.md (avec ton accord). -->
              <ToggleButton Classes="report" IsChecked="{Binding WriteReport}" Height="32" Padding="12,0"
                            ToolTip.Tip="Revue à deux agents : l’Analyste rend ses constats, le Rédacteur écrit REPORT.md, que tu approuves">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Path Data="M7 3.5h7l5 5v12H7zM14 3.5v5h5M10 13h6M10 16.5h6" Stroke="{Binding $parent[ToggleButton].Foreground}"
                        StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" Width="13" Height="13" Stretch="Uniform" />
                  <TextBlock Classes="mono" Text="REPORT.md" FontSize="11.5" VerticalAlignment="Center" />
                </StackPanel>
              </ToggleButton>
              <!-- Le projet de la mission (ADR 0009) ; sans choix, le projet personnel. -->
              <ComboBox Grid.Column="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" Height="32"
                        MinWidth="150" MaxWidth="240" PlaceholderText="Projet personnel" ToolTip.Tip="Le projet de la mission">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="contracts:ProjectDto">
                    <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Column="2" Text="{Binding Error}" Foreground="{StaticResource Cinabre}" FontSize="12.5"
                         TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="3" Classes="send" Command="{Binding LaunchMissionCommand}"
                      Width="42" Height="42" Padding="0" HotKey="Ctrl+Enter"
                      ToolTip.Tip="Lancer la mission (Ctrl+Entrée)"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <Path Data="M12 19V5M6 11l6-6 6 6" Stroke="{StaticResource Obsidienne}" StrokeThickness="2.2"
                      StrokeLineCap="Round" StrokeJoin="Round" Width="18" Height="18" Stretch="Uniform" />
              </Button>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Suggestions -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Suggestions}" HorizontalAlignment="Center" Margin="0,16,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Button Classes="chip" Content="{Binding}" Height="34" Padding="14,0" FontSize="13"
                      VerticalContentAlignment="Center"
                      Command="{Binding $parent[ItemsControl].((core:HomeViewModel)DataContext).UseSuggestionCommand}"
                      CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- En cours -->
        <StackPanel Grid.Row="6" Spacing="12" Margin="0,48,0,0" IsVisible="{Binding Missions.Count}">
          <TextBlock Classes="mono" Text="RÉCENTES" FontSize="10.5" LetterSpacing="1.5" Foreground="{StaticResource Cendre}" />
          <ItemsControl ItemsSource="{Binding Missions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:MissionItem">
                <Button Classes="bare" Margin="0,0,12,12" ToolTip.Tip="Ouvrir la mission"
                        Command="{Binding $parent[ItemsControl].((core:HomeViewModel)DataContext).OpenMissionCommand}"
                        CommandParameter="{Binding}">
                <Border Classes="mission" Classes.completed="{Binding IsCompleted}" Classes.failed="{Binding IsFailed}"
                        Classes.awaiting="{Binding IsAwaitingApproval}"
                        Padding="16,14" CornerRadius="16" BorderThickness="1">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Panel Width="36" Height="36">
                      <Ellipse Classes="pulse" Stroke="{StaticResource VertDeGris}" StrokeThickness="1.5" IsVisible="{Binding IsActive}" />
                      <Ellipse Stroke="{StaticResource VertDeGris}" StrokeThickness="1.5" IsVisible="{Binding IsActive}" />
                      <Ellipse Width="8" Height="8" Fill="{StaticResource VertDeGris}" IsVisible="{Binding IsActive}" />
                      <Ellipse Fill="#14ECE6D8" IsVisible="{Binding IsCompleted}" />
                      <Path Data="M5 12.5l4.5 4.5L19 7.5" Stroke="{StaticResource Parchemin}" StrokeThickness="2.4"
                            StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" Stretch="Uniform"
                            IsVisible="{Binding IsCompleted}" />
                      <Ellipse Stroke="{StaticResource Cinabre}" StrokeThickness="1.5" IsVisible="{Binding IsFailed}" />
                      <Path Data="M7 7l10 10M17 7L7 17" Stroke="{StaticResource Cinabre}" StrokeThickness="2"
                            StrokeLineCap="Round" Width="11" Height="11" Stretch="Uniform" IsVisible="{Binding IsFailed}" />
                      <Ellipse Stroke="{StaticResource Laiton}" StrokeThickness="1.5" IsVisible="{Binding IsAwaitingApproval}" />
                      <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Laiton}"
                                 RenderTransform="rotate(45deg)" IsVisible="{Binding IsAwaitingApproval}" />
                    </Panel>
                    <TextBlock Grid.Column="1" Text="{Binding Goal}" FontSize="14" FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" FontSize="12"
                               Foreground="{StaticResource Cendre}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </ScrollViewer>

  </Grid>
</UserControl>
