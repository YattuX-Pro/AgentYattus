<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:AgentYattus.Client.Core"
             x:Class="AgentYattus.Desktop.Views.MissionView"
             x:DataType="core:MissionViewModel"
             Foreground="{StaticResource Parchemin}">

  <UserControl.Styles>
    <!-- Un nœud du déroulement : cercle de 76 px, légende dessous. -->
    <Style Selector="StackPanel.node">
      <Setter Property="Width" Value="136" />
      <Setter Property="Spacing" Value="10" />
    </Style>
    <Style Selector="TextBlock.nodeTitle">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.nodeSub">
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{StaticResource Cendre}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <!-- Lien entre deux nœuds, aligné sur le centre des cercles. -->
    <Style Selector="Border.link">
      <Setter Property="Height" Value="2" />
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="Margin" Value="0,37,0,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Background" Value="#3A3F45" />
    </Style>
    <Style Selector="Border.link.done">
      <Setter Property="Background" Value="{StaticResource VertDeGris}" />
    </Style>
    <Style Selector="Border.link.human">
      <Setter Property="Background" Value="#99D8B86E" />
    </Style>
    <!-- Halo laiton : une décision humaine est attendue. -->
    <Style Selector="Ellipse.pulseBrass">
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Style.Animations>
        <Animation Duration="0:0:2.4" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.7" /><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
          <KeyFrame Cue="70%"><Setter Property="Opacity" Value="0" /><Setter Property="ScaleTransform.ScaleX" Value="1.45" /><Setter Property="ScaleTransform.ScaleY" Value="1.45" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /><Setter Property="ScaleTransform.ScaleX" Value="1.45" /><Setter Property="ScaleTransform.ScaleY" Value="1.45" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- Boutons de la carte d'approbation : laiton pour approuver, contour pour refuser. -->
    <Style Selector="Button.approve, Button.refuse">
      <Setter Property="Height" Value="46" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.approve /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Laiton}" />
      <Setter Property="Foreground" Value="#17140C" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.approve:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E4C888" />
      <Setter Property="Foreground" Value="#17140C" />
    </Style>
    <Style Selector="Button.refuse /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#3A3F45" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Parchemin}" />
    </Style>
    <Style Selector="Button.refuse:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#14D9654B" />
      <Setter Property="BorderBrush" Value="#66D9654B" />
      <Setter Property="Foreground" Value="{StaticResource Parchemin}" />
    </Style>

    <!-- Pastille de statut en haut de l'écran. -->
    <Style Selector="Border.pill">
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Background" Value="#12ECE6D8" />
    </Style>
    <Style Selector="Border.pill.awaiting">
      <Setter Property="Background" Value="#1FD8B86E" />
      <Setter Property="BorderBrush" Value="#4DD8B86E" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.pill.awaiting TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Laiton}" />
    </Style>
    <Style Selector="Border.pill.failed">
      <Setter Property="Background" Value="#14D9654B" />
    </Style>
    <Style Selector="Border.pill.failed TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Cinabre}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Titre : retour, objectif, statut -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Margin="40,18,40,0">
      <Button Classes="square" Width="36" Height="36" Padding="0" ToolTip.Tip="Retour à l'accueil"
              Command="{Binding $parent[Window].((core:ShellViewModel)DataContext).GoHomeCommand}"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
        <Path Data="M15 6l-6 6 6 6" Stroke="{StaticResource Parchemin}" StrokeThickness="2" StrokeLineCap="Round"
              StrokeJoin="Round" Width="16" Height="16" Stretch="Uniform" />
      </Button>
      <TextBlock Grid.Column="1" Text="{Binding Mission.Goal}" FontSize="22" FontWeight="SemiBold" LetterSpacing="-0.3"
                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <Border Grid.Column="2" Classes="pill" Classes.awaiting="{Binding Mission.IsAwaitingApproval}"
              Classes.failed="{Binding Mission.IsFailed}" VerticalAlignment="Center">
        <TextBlock Text="{Binding Mission.StatusLabel}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
      </Border>
    </Grid>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="40,32" Spacing="32">
        <Grid x:Name="Main" ColumnDefinitions="*,Auto" ColumnSpacing="36">

          <!-- Déroulement : Objectif → Analyste → Vous → Rapport -->
          <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto" HorizontalAlignment="Center" VerticalAlignment="Center">

            <StackPanel Grid.Column="0" Classes="node">
              <Panel Width="76" Height="76">
                <Border Width="58" Height="58" CornerRadius="18" Background="{StaticResource Graphite}" BorderBrush="#2B2F34" BorderThickness="1">
                  <Viewbox Width="24" Height="24">
                    <Canvas Width="24" Height="24">
                      <Ellipse Canvas.Left="4" Canvas.Top="4" Width="16" Height="16" Stroke="{StaticResource Parchemin}" StrokeThickness="1.6" />
                      <Ellipse Canvas.Left="8" Canvas.Top="8" Width="8" Height="8" Stroke="{StaticResource Parchemin}" StrokeThickness="1.6" />
                      <Ellipse Canvas.Left="11.2" Canvas.Top="11.2" Width="1.6" Height="1.6" Fill="{StaticResource Parchemin}" />
                    </Canvas>
                  </Viewbox>
                </Border>
              </Panel>
              <TextBlock Classes="nodeTitle" Text="Objectif" />
            </StackPanel>

            <Border Grid.Column="1" Classes="link done" />

            <!-- L'agent : il pulse tant qu'il travaille ; dessous, les outils qu'il a utilisés. -->
            <StackPanel Grid.Column="2" Classes="node">
              <Panel Width="76" Height="76">
                <Ellipse Classes="pulse" Stroke="{StaticResource VertDeGris}" StrokeThickness="2" IsVisible="{Binding Mission.IsActive}" />
                <Ellipse Fill="{StaticResource Graphite}" Stroke="{StaticResource VertDeGris}" StrokeThickness="2" />
                <Viewbox Width="32" Height="32">
                  <Canvas Width="20" Height="20">
                    <Path Data="M5 14L10 5l5 9z" Stroke="{StaticResource VertDeGris}" StrokeThickness="1.2" StrokeJoin="Round" />
                    <Ellipse Canvas.Left="8.2" Canvas.Top="3.2" Width="3.6" Height="3.6" Fill="{StaticResource Parchemin}" />
                    <Ellipse Canvas.Left="3.2" Canvas.Top="12.2" Width="3.6" Height="3.6" Fill="{StaticResource Parchemin}" />
                    <Ellipse Canvas.Left="13.2" Canvas.Top="12.2" Width="3.6" Height="3.6" Fill="{StaticResource Parchemin}" />
                  </Canvas>
                </Viewbox>
                <!-- Pastille de fin : coche si terminée, croix si échec. -->
                <Border Width="22" Height="22" CornerRadius="11" BorderBrush="{StaticResource Obsidienne}" BorderThickness="3"
                        Background="{StaticResource VertDeGris}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        IsVisible="{Binding Mission.IsCompleted}">
                  <Path Data="M5 12.5l4.5 4.5L19 7.5" Stroke="{StaticResource Obsidienne}" StrokeThickness="3.5"
                        StrokeLineCap="Round" StrokeJoin="Round" Width="9" Height="9" Stretch="Uniform" />
                </Border>
                <Border Width="22" Height="22" CornerRadius="11" BorderBrush="{StaticResource Obsidienne}" BorderThickness="3"
                        Background="{StaticResource Cinabre}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        IsVisible="{Binding Mission.IsFailed}">
                  <Path Data="M6 6l12 12M18 6L6 18" Stroke="{StaticResource Obsidienne}" StrokeThickness="3.5"
                        StrokeLineCap="Round" Width="8" Height="8" Stretch="Uniform" />
                </Border>
              </Panel>
              <StackPanel Spacing="1">
                <TextBlock Classes="nodeTitle" Text="Analyste" />
                <TextBlock Classes="nodeSub" Text="{Binding Mission.AgentLabel}" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Tools}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="core:ToolUsage">
                    <Border Height="26" Padding="10,0" CornerRadius="8" Background="{StaticResource Nuit}"
                            BorderBrush="{StaticResource Filet}" BorderThickness="1" HorizontalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource VertDeGris}" />
                        <TextBlock Classes="mono" Text="{Binding Name}" FontSize="11.5" />
                        <TextBlock Classes="mono" Text="{Binding Count}" FontSize="11.5" Foreground="{StaticResource Cendre}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Border Grid.Column="3" Classes="link" Classes.human="{Binding HumanInvolved}" />

            <!-- Vous : losange laiton, qui pulse quand votre décision est attendue. -->
            <StackPanel Grid.Column="4" Classes="node">
              <Panel Width="76" Height="76">
                <Ellipse Classes="pulseBrass" Stroke="{StaticResource Laiton}" StrokeThickness="2" IsVisible="{Binding Mission.IsAwaitingApproval}" />
                <Ellipse Fill="#1AD8B86E" Stroke="{StaticResource Laiton}" StrokeThickness="2" IsVisible="{Binding HumanInvolved}" />
                <Rectangle Width="20" Height="20" RadiusX="4" RadiusY="4" Fill="{StaticResource Laiton}" RenderTransform="rotate(45deg)"
                           IsVisible="{Binding HumanInvolved}" />
                <!-- Aucune décision n'a été nécessaire : nœud éteint. -->
                <Ellipse Stroke="#3A3F45" StrokeThickness="2" StrokeDashArray="3,2" IsVisible="{Binding !HumanInvolved}" />
                <Rectangle Width="14" Height="14" RadiusX="3" RadiusY="3" Stroke="#4A4F55" StrokeThickness="1.5"
                           RenderTransform="rotate(45deg)" IsVisible="{Binding !HumanInvolved}" />
                <Border Width="22" Height="22" CornerRadius="11" BorderBrush="{StaticResource Obsidienne}" BorderThickness="3"
                        Background="{StaticResource Laiton}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        IsVisible="{Binding IsApproved}">
                  <Path Data="M5 12.5l4.5 4.5L19 7.5" Stroke="{StaticResource Obsidienne}" StrokeThickness="3.5"
                        StrokeLineCap="Round" StrokeJoin="Round" Width="9" Height="9" Stretch="Uniform" />
                </Border>
                <Border Width="22" Height="22" CornerRadius="11" BorderBrush="{StaticResource Obsidienne}" BorderThickness="3"
                        Background="{StaticResource Cinabre}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        IsVisible="{Binding IsRefused}">
                  <Path Data="M6 6l12 12M18 6L6 18" Stroke="{StaticResource Obsidienne}" StrokeThickness="3.5"
                        StrokeLineCap="Round" Width="8" Height="8" Stretch="Uniform" />
                </Border>
              </Panel>
              <StackPanel Spacing="1">
                <TextBlock Classes="nodeTitle" Text="Vous" />
                <TextBlock Classes="nodeSub" Text="non sollicité" IsVisible="{Binding !HumanInvolved}" />
                <TextBlock Classes="nodeSub" Text="décision" Foreground="{StaticResource Laiton}" IsVisible="{Binding Mission.IsAwaitingApproval}" />
                <TextBlock Classes="nodeSub" Text="approuvé" IsVisible="{Binding IsApproved}" />
                <TextBlock Classes="nodeSub" Text="refusé" IsVisible="{Binding IsRefused}" />
              </StackPanel>
            </StackPanel>

            <Border Grid.Column="5" Classes="link" Classes.done="{Binding Result, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Rapport : en pointillés tant qu'il n'existe pas. -->
            <StackPanel Grid.Column="6" Classes="node">
              <Panel Width="76" Height="76">
                <Ellipse Stroke="#3A3F45" StrokeThickness="2" StrokeDashArray="3,2"
                         IsVisible="{Binding Result, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                <Ellipse Fill="{StaticResource Graphite}" Stroke="{StaticResource VertDeGris}" StrokeThickness="2"
                         IsVisible="{Binding Result, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Path Data="M7 3.5h7l5 5v12H7zM14 3.5v5h5M10 13h6M10 16.5h6" Stroke="{StaticResource Pierre}" StrokeThickness="1.6"
                      StrokeLineCap="Round" StrokeJoin="Round" Width="26" Height="26" Stretch="Uniform" />
              </Panel>
              <StackPanel Spacing="1">
                <TextBlock Classes="nodeTitle" Text="Rapport" />
                <TextBlock Classes="nodeSub" Text="à venir" IsVisible="{Binding Result, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                <TextBlock Classes="nodeSub" Text="prêt" Foreground="{StaticResource VertDeGris}"
                           IsVisible="{Binding Result, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- Carte d'approbation : ce que l'agent veut faire, mot pour mot, et ta décision. -->
          <Border Grid.Column="1" Width="380" Padding="22" CornerRadius="22" VerticalAlignment="Center"
                  Background="{StaticResource Graphite}" BorderBrush="#73D8B86E" BorderThickness="1"
                  BoxShadow="0 30 90 0 #8C000000, 0 0 0 6 #0DD8B86E"
                  IsVisible="{Binding IsDecisionPending}">
            <StackPanel Spacing="14">
              <ItemsControl ItemsSource="{Binding PendingApproval}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="16" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="core:ApprovalItem">
                    <StackPanel Spacing="12">
                      <StackPanel Orientation="Horizontal" Spacing="9">
                        <Rectangle Width="8" Height="8" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Laiton}" RenderTransform="rotate(45deg)" />
                        <TextBlock Classes="mono" Text="{Binding Tool}" FontSize="12" Foreground="{StaticResource Laiton}" />
                      </StackPanel>
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" LetterSpacing="-0.4" TextWrapping="Wrap" />
                        <TextBlock Classes="mono" Text="{Binding Target}" FontSize="12" Foreground="{StaticResource Pierre}"
                                   IsVisible="{Binding Target, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                      <!-- Le contenu, comme un diff : chaque ligne ajoutée commence par « + ». -->
                      <Border Padding="12,10" CornerRadius="12" Background="{StaticResource Obsidienne}"
                              BorderBrush="{StaticResource Filet}" BorderThickness="1">
                        <StackPanel>
                          <ItemsControl ItemsSource="{Binding Preview}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="x:String">
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Classes="mono" Text="+ " FontSize="12" LineHeight="21" Foreground="{StaticResource VertDeGris}" />
                                  <TextBlock Classes="mono" Text="{Binding}" FontSize="12" LineHeight="21" Foreground="{StaticResource Parchemin}"
                                             TextTrimming="CharacterEllipsis" MaxWidth="300" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Classes="mono" FontSize="12" LineHeight="21" Foreground="{StaticResource Cendre}"
                                     IsVisible="{Binding HasMoreLines}"
                                     Text="{Binding MoreLines, StringFormat='  +{0} lignes'}" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,1.4*" ColumnSpacing="10">
                <Button Classes="refuse" Content="Refuser" Command="{Binding RefuseCommand}" />
                <Button Grid.Column="1" Classes="approve" Content="Approuver" Command="{Binding ApproveCommand}" />
              </Grid>
            </StackPanel>
          </Border>
        </Grid>

        <!-- La réponse de l'agent, une fois la mission terminée -->
        <Border MaxWidth="900" Padding="22,20" CornerRadius="20" Background="{StaticResource Graphite}"
                BorderBrush="{StaticResource Filet}" BorderThickness="1"
                IsVisible="{Binding Result, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <StackPanel Spacing="10">
            <TextBlock Classes="eyebrow" Text="RÉPONSE DE L’AGENT" />
            <SelectableTextBlock Text="{Binding Result}" TextWrapping="Wrap" FontSize="14" LineHeight="22" />
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Cinabre}" FontSize="12.5" HorizontalAlignment="Center"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </ScrollViewer>

    <!-- Journal : une marque par événement, la plus récente à droite -->
    <Border Grid.Row="2" Margin="40,0,40,24" Padding="18,12" CornerRadius="16" Background="#EB16181B"
            BorderBrush="{StaticResource Filet}" BorderThickness="1">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Journal" FontSize="13" FontWeight="Medium" />
          <TextBlock Classes="mono" Text="{Binding Journal.Count}" FontSize="11.5" Foreground="{StaticResource Cendre}" />
        </StackPanel>
        <Panel Grid.Column="1" Height="28">
          <Border Height="1" Background="#2B2F34" VerticalAlignment="Center" />
          <ItemsControl ItemsSource="{Binding Journal}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:TimelineEntry">
                <Panel Width="14" Height="14" HorizontalAlignment="Center" ToolTip.Tip="{Binding Label}">
                  <!-- Exécuté : point vert. Décision : losange laiton. Échec ou refus : croix cinabre. Statut : point clair. -->
                  <Ellipse Width="8" Height="8" Fill="{StaticResource VertDeGris}" IsVisible="{Binding IsTool}" />
                  <Ellipse Width="6" Height="6" Fill="{StaticResource Pierre}" IsVisible="{Binding IsStatus}" />
                  <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource Laiton}" RenderTransform="rotate(45deg)"
                             IsVisible="{Binding IsDecision}" />
                  <Ellipse Fill="#2A1814" IsVisible="{Binding IsFailure}" />
                  <Path Data="M6 6l12 12M18 6L6 18" Stroke="{StaticResource Cinabre}" StrokeThickness="4" StrokeLineCap="Round"
                        Width="8" Height="8" Stretch="Uniform" IsVisible="{Binding IsFailure}" />
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Panel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding LastEntry.Label}" FontSize="12.5" />
          <TextBlock Classes="mono" Text="{Binding LastEntry.At, StringFormat='{}{0:HH:mm}'}" FontSize="11.5" Foreground="{StaticResource Cendre}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
