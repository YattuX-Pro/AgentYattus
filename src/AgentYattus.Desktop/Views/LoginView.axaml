<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:AgentYattus.Client.Core"
             x:Class="AgentYattus.Desktop.Views.LoginView"
             x:DataType="core:LoginViewModel"
             Foreground="{StaticResource Parchemin}">

  <UserControl.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Height" Value="46" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource VertDeGris}" />
      <Setter Property="Foreground" Value="{StaticResource Obsidienne}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#6FB3A6" />
      <Setter Property="Foreground" Value="{StaticResource Obsidienne}" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Filet}" />
      <Setter Property="Foreground" Value="{StaticResource Cendre}" />
    </Style>
  </UserControl.Styles>

  <!-- Une seule carte au centre : pas de formulaire, la connexion se fait dans le navigateur. -->
  <Border Width="400" Padding="30,32" CornerRadius="22" HorizontalAlignment="Center" VerticalAlignment="Center"
          Background="{StaticResource Graphite}" BorderBrush="#2B2F34" BorderThickness="1" BoxShadow="0 30 90 0 #80000000">
    <StackPanel Spacing="20">
      <Viewbox Width="44" Height="44" HorizontalAlignment="Left">
        <Canvas Width="26" Height="26">
          <Rectangle Canvas.Left="0.5" Canvas.Top="0.5" Width="25" Height="25" RadiusX="7" RadiusY="7" Stroke="#2B2F34" />
          <Path Data="M13 13.5V19.5M13 13.5L7.5 7.5M13 13.5L18.5 7.5" Stroke="{StaticResource VertDeGris}" StrokeThickness="1.6" StrokeLineCap="Round" />
          <Ellipse Canvas.Left="5.6" Canvas.Top="5.6" Width="3.8" Height="3.8" Fill="{StaticResource Parchemin}" />
          <Ellipse Canvas.Left="16.6" Canvas.Top="5.6" Width="3.8" Height="3.8" Fill="{StaticResource Parchemin}" />
          <Ellipse Canvas.Left="11.1" Canvas.Top="17.6" Width="3.8" Height="3.8" Fill="{StaticResource Laiton}" />
          <Ellipse Canvas.Left="10.8" Canvas.Top="11.3" Width="4.4" Height="4.4" Fill="{StaticResource Obsidienne}" Stroke="{StaticResource VertDeGris}" StrokeThickness="1.6" />
        </Canvas>
      </Viewbox>
      <StackPanel Spacing="6">
        <TextBlock Text="Connexion" FontSize="26" FontWeight="SemiBold" LetterSpacing="-0.5" />
        <TextBlock Text="La connexion s’ouvre dans ton navigateur. Agent Yattus ne voit jamais ton mot de passe."
                   FontSize="13.5" Foreground="{StaticResource Pierre}" TextWrapping="Wrap" />
      </StackPanel>
      <Button Classes="primary" Command="{Binding LoginCommand}" Content="Se connecter" />
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
        <Ellipse Width="7" Height="7" Fill="{StaticResource Laiton}" VerticalAlignment="Center" />
        <TextBlock Text="En attente du navigateur…" FontSize="12.5" Foreground="{StaticResource Pierre}" />
      </StackPanel>
      <TextBlock Text="{Binding Error}" FontSize="12.5" Foreground="{StaticResource Cinabre}" TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </Border>
</UserControl>
